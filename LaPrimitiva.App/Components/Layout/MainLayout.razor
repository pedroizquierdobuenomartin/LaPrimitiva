@using LaPrimitiva.Application.Services
@using LaPrimitiva.Application.Interfaces
@using LaPrimitiva.Domain.Localization
@using LaPrimitiva.Domain.Interfaces
@using LaPrimitiva.Domain.Models
@using Microsoft.Extensions.Localization
@inherits LayoutComponentBase
@inject GlobalState GlobalState
@inject IServiceScopeFactory ScopeFactory
@inject IStringLocalizer<GlobalResource> L
@inject IStringLocalizer<DashboardResource> LD
@inject NavigationManager NavigationManager
@inject IDrawNotificationService NotificationService
@inject ILocalStorageService LocalStorageService
@implements IDisposable

<div class="h-screen flex bg-[var(--brand-bg)] overflow-hidden font-sans relative">
    <!-- Left Sidebar Space Holder -->
    <div class="hidden md:block transition-all duration-300 ease-in-out @(_isCollapsed ? "w-20" : "w-60") flex-shrink-0"></div>

    <!-- Sidebar Left -->
    <aside @onmouseenter="() => _isHovered = true" 
           @onmouseleave="() => _isHovered = false"
           class="@(_isCollapsed ? (_isHovered ? "w-60 shadow-2xl z-[70] sidebar-overlay-effect" : "w-20") : "w-60") @(_showMobileMenu ? "translate-x-0" : "-translate-x-full md:translate-x-0") bg-[var(--brand-secondary)] text-white/80 flex-shrink-0 flex flex-col transition-all duration-300 ease-in-out fixed md:absolute md:inset-y-0 left-0 h-full border-r border-white/5 z-[60]">
        
        <div class="h-32 flex items-center justify-center border-b border-white/10 flex-shrink-0 relative">
            <div class="flex flex-col items-center w-full gap-3 transition-all duration-500 @((_isCollapsed && !_isHovered) ? "scale-90" : "scale-100")">
                <div class="p-2.5 bg-white/5 rounded-2xl shadow-inner border border-white/5 flex items-center justify-center transition-all hover:bg-white/10 hover:scale-105 active:scale-95">
                    <img src="/images/logo_white.png" class="@((_isCollapsed && !_isHovered) ? "h-7 w-7" : "h-8 w-8") object-contain transition-all duration-500" alt="Logo" />
                </div>
                <div class="overflow-hidden transition-all duration-500 ease-in-out @((_isCollapsed && !_isHovered) ? "max-h-0 opacity-0" : "max-h-10 opacity-100")">
                    <span class="text-[11px] font-bold text-white uppercase tracking-[0.2em] whitespace-nowrap">
                        La <span class="text-[var(--brand-accent)]">P</span>rimitiva
                    </span>
                </div>
            </div>

            <!-- Toggle Button Inside Header -->
            @if (!_isCollapsed || _isHovered)
            {
                <button @onclick="ToggleSidebar" class="absolute right-4 top-4 text-white/40 hover:text-white transition-all z-[70] p-1 rounded-lg hover:bg-white/10" aria-label="Toggle Sidebar">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            }
        </div>

        <nav class="flex-1 @((_isCollapsed && !_isHovered) ? "px-0" : "px-3") space-y-2 mt-8 overflow-x-hidden scrollbar-hide">
            <NavLink href="" Match="NavLinkMatch.All" class="@($"nav-item w-full flex items-center {(_isCollapsed && !_isHovered ? "justify-center px-0" : "gap-4 px-5 text-left")} py-4 rounded-xl hover:bg-white/10 transition-all duration-300 group text-white/70 relative")" ActiveClass="active-nav bg-white/15 text-white shadow-lg" title="@L["Dashboard"]">
                <div class="flex items-center justify-center w-10 h-10 flex-shrink-0 rounded-lg group-hover:scale-110 transition-transform duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                    </svg>
                </div>
                <div class="overflow-hidden transition-all duration-500 ease-in-out @((_isCollapsed && !_isHovered) ? "w-0 opacity-0" : "w-full opacity-100")">
                    <span class="font-medium tracking-wide whitespace-nowrap">@L["Dashboard"]</span>
                </div>
            </NavLink>

            <NavLink href="planes" class="@($"nav-item w-full flex items-center {(_isCollapsed && !_isHovered ? "justify-center px-0" : "gap-4 px-5 text-left")} py-4 rounded-xl hover:bg-white/10 transition-all duration-300 group text-white/70 relative")" ActiveClass="active-nav bg-white/15 text-white shadow-lg" title="@L["Plans"]">
                <div class="flex items-center justify-center w-10 h-10 flex-shrink-0 rounded-lg group-hover:scale-110 transition-transform duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                    </svg>
                </div>
                <div class="overflow-hidden transition-all duration-500 ease-in-out @((_isCollapsed && !_isHovered) ? "w-0 opacity-0" : "w-full opacity-100")">
                    <span class="font-medium tracking-wide whitespace-nowrap">@L["Plans"]</span>
                </div>
            </NavLink>

            <NavLink href="registro" class="@($"nav-item w-full flex items-center {(_isCollapsed && !_isHovered ? "justify-center px-0" : "gap-4 px-5 text-left")} py-4 rounded-xl hover:bg-white/10 transition-all duration-300 group text-white/70 relative")" ActiveClass="active-nav bg-white/15 text-white shadow-lg" title="@L["Registration"]">
                <div class="flex items-center justify-center w-10 h-10 flex-shrink-0 rounded-lg group-hover:scale-110 transition-transform duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 100 4m0-4a2 2 0 110 4m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                    </svg>
                </div>
                <div class="overflow-hidden transition-all duration-500 ease-in-out @((_isCollapsed && !_isHovered) ? "w-0 opacity-0" : "w-full opacity-100")">
                    <span class="font-medium tracking-wide whitespace-nowrap">@L["Registration"]</span>
                </div>
            </NavLink>

            <NavLink href="historico" class="@($"nav-item w-full flex items-center {(_isCollapsed && !_isHovered ? "justify-center px-0" : "gap-4 px-5 text-left")} py-4 rounded-xl hover:bg-white/10 transition-all duration-300 group text-white/70 relative")" ActiveClass="active-nav bg-white/15 text-white shadow-lg" title="@L["Historical"]">
                <div class="flex items-center justify-center w-10 h-10 flex-shrink-0 rounded-lg group-hover:scale-110 transition-transform duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div class="overflow-hidden transition-all duration-500 ease-in-out @((_isCollapsed && !_isHovered) ? "w-0 opacity-0" : "w-full opacity-100")">
                    <span class="font-medium tracking-wide whitespace-nowrap">@L["Historical"]</span>
                </div>
            </NavLink>

            <NavLink href="datos" class="@($"nav-item w-full flex items-center {(_isCollapsed && !_isHovered ? "justify-center px-0" : "gap-4 px-5 text-left")} py-4 rounded-xl hover:bg-white/10 transition-all duration-300 group text-white/70 relative")" ActiveClass="active-nav bg-white/15 text-white shadow-lg" title="@L["Data"]">
                <div class="flex items-center justify-center w-10 h-10 flex-shrink-0 rounded-lg group-hover:scale-110 transition-transform duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a2 2 0 002 2h12a2 2 0 002-2v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                    </svg>
                </div>
                <div class="overflow-hidden transition-all duration-500 ease-in-out @((_isCollapsed && !_isHovered) ? "w-0 opacity-0" : "w-full opacity-100")">
                    <span class="font-medium tracking-wide whitespace-nowrap">@L["Data"]</span>
                </div>
            </NavLink>
        </nav>
    </aside>

    <div class="flex-1 flex flex-col overflow-hidden bg-[#f8fafc]">
        <!-- Top Navigation -->
        <header class="h-16 min-h-[64px] bg-[#f8fafc] border-b border-[var(--brand-borders)]/10 flex items-center justify-between px-6 z-50 flex-shrink-0">
            <div class="flex items-center gap-4">
                <button @onclick="ToggleMobileMenu" class="md:hidden p-2 text-[var(--brand-secondary)] hover:bg-gray-100 rounded-lg transition-all" aria-label="Open Menu">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
                <div class="hidden md:block">
                    <Breadcrumb />
                </div>
            </div>

            <div class="flex items-center gap-4">
                <!-- Year Selector -->
                @if (!_isHistoricalPage)
                {
                    <div class="flex items-center gap-2">
                        <span class="text-[10px] font-bold text-[var(--brand-text-secondary)] uppercase tracking-wider hidden sm:block">@LD["SelectedYear"]</span>
                        <select @bind="GlobalState.SelectedYear" disabled="@GlobalState.IsHistoricalView" 
                                class="bg-gray-50 border border-[var(--brand-borders)] text-[var(--brand-secondary)] text-xs rounded-lg px-2 py-1 outline-none focus:ring-1 focus:ring-[var(--brand-primary)]">
                            @if (_availableYears != null)
                            {
                                @foreach (var y in _availableYears)
                                {
                                    <option value="@y">@y</option>
                                }
                            }
                        </select>
                    </div>
                }

                @if (_isDashboard)
                {
                    <div class="flex bg-gray-100 p-1 rounded-lg scale-90 sm:scale-100">
                        <button @onclick="() => SetHistorical(false)" class="px-3 py-1 text-[10px] font-bold rounded-md transition-all @(!GlobalState.IsHistoricalView ? "bg-white text-[var(--brand-primary)] shadow-sm" : "text-gray-500 hover:text-gray-700")">
                            @LD["Yearly"]
                        </button>
                        <button @onclick="() => SetHistorical(true)" class="px-3 py-1 text-[10px] font-bold rounded-md transition-all @(GlobalState.IsHistoricalView ? "bg-white text-[var(--brand-primary)] shadow-sm" : "text-gray-500 hover:text-gray-700")">
                            @LD["Historical"]
                        </button>
                    </div>
                }
            </div>
        </header>

        <div class="flex-1 flex overflow-hidden relative">
            <!-- Main Workspace -->
            <main class="flex-1 flex flex-col min-w-0 bg-[#f8fafc] relative overflow-hidden">
                <!-- Scrollable Content -->
                <div class="flex-1 overflow-y-auto p-4 md:p-8 scroll-smooth pb-20 md:pb-8">
                    @Body
                </div>

                <!-- Mobile Bottom Navigation -->
                <nav class="fixed bottom-0 left-0 right-0 h-16 bg-white border-t border-gray-100 md:hidden flex items-center justify-around z-[60] px-2 shadow-[0_-4px_12px_rgba(0,0,0,0.05)]">
                    <NavLink href="" Match="NavLinkMatch.All" class="flex flex-col items-center justify-center gap-1 text-gray-400 transition-all hover:text-[var(--brand-primary)]" ActiveClass="!text-[var(--brand-primary)]">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 transition-transform active:scale-90" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                        </svg>
                        <span class="text-[9px] font-bold uppercase tracking-tighter">@L["Dashboard"]</span>
                    </NavLink>

                    <NavLink href="planes" class="flex flex-col items-center justify-center gap-1 text-gray-400 transition-all hover:text-[var(--brand-primary)]" ActiveClass="!text-[var(--brand-primary)]">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 transition-transform active:scale-90" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                        </svg>
                        <span class="text-[9px] font-bold uppercase tracking-tighter">@L["Plans"]</span>
                    </NavLink>

                    <NavLink href="registro" class="flex flex-col items-center justify-center gap-1 text-gray-400 transition-all hover:text-[var(--brand-primary)]" ActiveClass="!text-[var(--brand-primary)]">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 transition-transform active:scale-90" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 100 4m0-4a2 2 0 110 4m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                        </svg>
                        <span class="text-[9px] font-bold uppercase tracking-tighter">@L["Registration"]</span>
                    </NavLink>

                    <button @onclick="ToggleRightMobileMenu" class="flex flex-col items-center justify-center gap-1 transition-all @(_showRightMobileMenu ? "text-[var(--brand-primary)]" : "text-gray-400")">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 transition-transform active:scale-90" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                        <span class="text-[9px] font-bold uppercase tracking-tighter">@L["User"]</span>
                    </button>

                    <button @onclick="ToggleMobileMenu" class="flex flex-col items-center justify-center gap-1 transition-all @(_showMobileMenu ? "text-[var(--brand-primary)]" : "text-gray-400")">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 transition-transform active:scale-90" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                        <span class="text-[9px] font-bold uppercase tracking-tighter">@L["Menu"]</span>
                    </button>
                </nav>

                <!-- Footer -->
                <footer class="h-12 border-t border-gray-200/50 bg-[#f8fafc] flex items-center justify-between px-8 text-[10px] text-gray-400 font-medium tracking-wider flex-shrink-0">
                    <div>&copy; 2026 LA PRIMITIVA AUDIT</div>
                    <div class="flex gap-4">
                        <a href="#" class="hover:text-[var(--brand-primary)]">@L["Help"]</a>
                        <a href="#" class="hover:text-[var(--brand-primary)]">@L["Privacy"]</a>
                        <a href="#" class="hover:text-[var(--brand-primary)]">@L["Contact"]</a>
                    </div>
                </footer>
            </main>
        </div>
    </div>

    <!-- Sidebar Right Space Holder -->
    <div class="hidden md:block w-16 flex-shrink-0 transition-all duration-300"></div>

    <!-- Sidebar Right (User/Config) -->
    <aside class="w-16 md:w-16 bg-white border-l border-gray-200 transition-all duration-300 ease-in-out flex flex-col fixed inset-y-0 right-0 z-[70] md:z-50 @(_showRightMobileMenu ? "translate-x-0 shadow-2xl" : "translate-x-full md:translate-x-0")">
        
        <!-- User Section -->
        <div class="h-32 flex flex-col items-center justify-center border-b border-gray-100 flex-shrink-0">
            <div class="relative group cursor-pointer">
                <div class="h-12 w-12 rounded-full overflow-hidden border-2 border-[var(--brand-accent)] transition-all group-hover:scale-110">
                    <div class="h-full w-full bg-[var(--brand-accent)] text-white flex items-center justify-center text-xl font-black">
                        P
                    </div>
                </div>
                <div class="absolute -bottom-1 -right-1 h-4 w-4 bg-green-500 border-2 border-white rounded-full"></div>
            </div>
            <div class="mt-2 overflow-hidden transition-all duration-300 opacity-0 max-h-0">
                <span class="text-[10px] font-bold text-gray-800 uppercase tracking-widest">johndoe</span>
            </div>
        </div>

        <!-- Icons Section -->
        <div class="flex-1 px-2 py-6 space-y-6 flex flex-col items-center">


            <div class="relative">
                <button @onclick="ToggleNotifications" class="p-2 transition-all hover:bg-gray-100 rounded-xl group relative @(_showNotifications ? "bg-indigo-50 ring-2 ring-[var(--brand-primary)]/10" : "hover:bg-gray-50")">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 @(GlobalState.HasNewDraws || _showNotifications ? "text-[var(--brand-primary)]" : "text-gray-400 group-hover:text-[var(--brand-primary)]")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                    </svg>
                    @if (GlobalState.HasNewDraws)
                    {
                        <div class="absolute -top-1 -right-1 h-5 w-5 bg-green-500 rounded-full border-2 border-white flex items-center justify-center text-[10px] text-white font-bold animate-pulse">
                            @GlobalState.NewDrawsCount
                        </div>
                    }
                </button>

            </div>
            
            <NavLink href="combinacion-automatica" class="p-2 transition-all hover:bg-gray-50 rounded-xl group relative block" ActiveClass="bg-indigo-50 ring-2 ring-[var(--brand-primary)]/10" title="Combinaciones Automáticas">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-400 group-hover:text-[var(--brand-primary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 22.25l-.394-1.683a2.25 2.25 0 00-1.623-1.623L12.75 18.5l1.733-.404a2.25 2.25 0 001.623-1.623L16.5 14.75l.394 1.683a2.25 2.25 0 001.623 1.623l1.833.428-1.743.407a2.25 2.25 0 00-1.623 1.623z" />
                </svg>
            </NavLink>

        </div>

        <!-- Settings Section -->
        <div class="p-4 space-y-4 border-t border-gray-100 flex flex-col items-center">
            <button class="p-2 transition-all hover:bg-gray-50 rounded-xl group relative">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400 group-hover:text-[var(--brand-primary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 9H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
            </button>

            <div class="p-2 text-[10px] font-bold text-gray-400 group cursor-pointer hover:text-[var(--brand-primary)] transition-all">
                ES
            </div>
        </div>
    </aside>

    @if (_showMobileMenu || _showRightMobileMenu)
    {
        <div class="fixed inset-0 bg-black/50 z-[55] md:hidden backdrop-blur-sm transition-opacity duration-300" @onclick="CloseAllMenus"></div>
    }

    <!-- Feedback Toast -->
    @if (!string.IsNullOrEmpty(_feedbackMessage))
    {
        <div class="fixed bottom-20 inset-x-4 md:inset-x-auto md:right-24 md:bottom-24 z-[9999] flex justify-center md:block animate-in slide-in-from-bottom-5 duration-500">
            <div class="px-6 py-4 rounded-[20px] shadow-2xl border flex items-center gap-4 w-full max-w-sm md:w-auto md:min-w-[320px] @(_isFeedbackError ? "bg-rose-50 border-rose-100 text-rose-800" : "bg-emerald-50 border-emerald-100 text-emerald-800")">
                <div class="h-10 w-10 @(_isFeedbackError ? "bg-rose-500/10 text-rose-500" : "bg-emerald-500/10 text-emerald-500") rounded-xl flex items-center justify-center">
                    @if (_isFeedbackError)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                    }
                </div>
                <div class="flex flex-col">
                    <span class="text-[10px] font-black uppercase tracking-widest opacity-50">@(_isFeedbackError ? "Error" : "Éxito")</span>
                    <span class="text-xs font-bold -mt-0.5">@_feedbackMessage</span>
                </div>
                <button @onclick="() => _feedbackMessage = null" class="ml-auto p-1.5 hover:bg-black/5 rounded-lg transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
        </div>
    }
</div>

    <!-- Notifications Dropdown Overlay & Panel (Moved to root to handle viewport properly) -->
    @if (_showNotifications)
    {
        <div class="fixed inset-0 z-[998] bg-transparent" @onclick="() => _showNotifications = false"></div>
        <div class="fixed left-0 right-16 top-16 bottom-16 md:right-20 md:top-24 md:left-auto md:bottom-auto md:w-[420px] bg-white md:rounded-[24px] rounded-none shadow-[0_20px_60px_-15px_rgba(0,0,0,0.1)] border border-gray-100/50 z-[999] overflow-hidden transition-all duration-300 transform scale-100 opacity-100 animate-in fade-in zoom-in duration-200 flex flex-col">
            <!-- Header -->
            <div class="p-6 border-b border-gray-50 bg-gradient-to-r from-gray-50/50 to-white flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-[var(--brand-primary)]/10 rounded-xl">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[var(--brand-primary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                        </svg>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-xs font-black text-gray-800 tracking-tight uppercase">Sorteos Recientes</span>
                        <span class="text-[10px] text-gray-400 font-medium">Resultados pendientes de registro</span>
                    </div>
                </div>
                <div class="flex items-center gap-1.5">
                    <button @onclick="() => NotificationService.CheckForNewDrawsAsync()" class="text-gray-400 hover:text-[var(--brand-primary)] p-2 hover:bg-gray-100 rounded-xl transition-all" title="Actualizar">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 @(GlobalState.IsLoading ? "animate-spin text-[var(--brand-primary)]" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                        </svg>
                    </button>
                    <button @onclick="() => _showNotifications = false" class="text-gray-400 hover:text-red-500 p-2 hover:bg-gray-100 rounded-xl transition-all">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </div>
            
            <div class="flex-1 overflow-y-auto custom-scrollbar">
                @if (GlobalState.IsLoading)
                {
                    <div class="p-16 text-center flex flex-col items-center gap-5">
                        <div class="h-12 w-12 border-4 border-[var(--brand-primary)]/10 border-t-[var(--brand-primary)] rounded-full animate-spin"></div>
                        <p class="text-[11px] font-black text-gray-400 uppercase tracking-[0.2em]">Sincronizando feed...</p>
                    </div>
                }
                else if (!string.IsNullOrEmpty(GlobalState.LastError))
                {
                    <div class="p-10 text-center flex flex-col items-center gap-4">
                        <div class="h-14 w-14 rounded-2xl bg-red-50 flex items-center justify-center border border-red-100">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                        </div>
                        <p class="text-[11px] font-bold text-red-500/80 uppercase tracking-tight leading-relaxed px-6">@GlobalState.LastError</p>
                        <button @onclick="() => NotificationService.CheckForNewDrawsAsync()" class="mt-2 px-6 py-2 bg-gray-50 hover:bg-gray-100 text-gray-600 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all border border-gray-100">Reintentar</button>
                    </div>
                }
                else if (GlobalState.RecentDraws == null || !GlobalState.RecentDraws.Any())
                {
                    <div class="p-16 text-center flex flex-col items-center gap-5">
                        <div class="h-16 w-16 rounded-[24px] bg-gray-50 flex items-center justify-center border border-gray-100/50">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                            </svg>
                        </div>
                        <div class="space-y-1">
                            <p class="text-xs font-black text-gray-800 uppercase tracking-wider">¡Todo al día!</p>
                            <p class="text-[10px] font-medium text-gray-400 uppercase tracking-widest leading-relaxed">No hay sorteos nuevos<br/>pendientes de registro</p>
                        </div>
                        <button @onclick="() => NotificationService.CheckForNewDrawsAsync()" class="mt-2 px-8 py-3 bg-[var(--brand-primary)] hover:bg-[var(--brand-secondary)] text-white text-[10px] font-black rounded-xl transition-all shadow-lg shadow-[var(--brand-primary)]/20 flex items-center gap-3 uppercase tracking-widest">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 @(GlobalState.IsLoading ? "animate-spin" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                            </svg>
                            Buscar Sorteos
                        </button>
                    </div>
                }
                else
                {
                    <div class="p-2 space-y-1">
                        @foreach (var draw in GlobalState.RecentDraws)
                        {
                            <div class="p-5 rounded-[20px] hover:bg-gray-50/80 transition-all cursor-pointer group border border-transparent hover:border-gray-100">
                                <div class="flex gap-5">
                                    <div class="h-14 w-14 rounded-2xl bg-white border border-gray-100 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-all duration-500 shadow-sm relative overflow-hidden">
                                        <div class="absolute inset-0 bg-gradient-to-br from-[var(--brand-primary)]/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                                        <!-- Precise Brand Logo SVG -->
                                        <svg class="h-10 w-10 relative z-10 text-[var(--brand-primary)]" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <!-- Brand Clover (4 Heart Leaves) -->
                                            <g class="animate-pulse" style="animation-duration: 4s;">
                                                <!-- Up leaf -->
                                                <path d="M50 48C50 38 42 32 35 32C28 32 24 38 24 45C24 55 45 68 50 72C55 68 76 55 76 45C76 38 72 32 65 32C58 32 50 38 50 48Z" fill="white" stroke="currentColor" stroke-width="2" transform="scale(0.5) translate(50 15)" />
                                                <!-- Right leaf -->
                                                <path d="M50 48C50 38 42 32 35 32C28 32 24 38 24 45C24 55 45 68 50 72C55 68 76 55 76 45C76 38 72 32 65 32C58 32 50 38 50 48Z" fill="white" stroke="currentColor" stroke-width="2" transform="rotate(90 50 50) scale(0.5) translate(50 15)" />
                                                <!-- Down leaf -->
                                                <path d="M50 48C50 38 42 32 35 32C28 32 24 38 24 45C24 55 45 68 50 72C55 68 76 55 76 45C76 38 72 32 65 32C58 32 50 38 50 48Z" fill="white" stroke="currentColor" stroke-width="2" transform="rotate(180 50 50) scale(0.5) translate(50 15)" />
                                                <!-- Left leaf -->
                                                <path d="M50 48C50 38 42 32 35 32C28 32 24 38 24 45C24 55 45 68 50 72C55 68 76 55 76 45C76 38 72 32 65 32C58 32 50 38 50 48Z" fill="white" stroke="currentColor" stroke-width="2" transform="rotate(270 50 50) scale(0.5) translate(50 15)" />
                                            </g>
                                            <!-- Brand Lottery Ball -->
                                            <g class="animate-bounce" style="animation-duration: 6s;">
                                                <circle cx="50" cy="65" r="14" fill="currentColor" stroke="white" stroke-width="1.5" />
                                                <circle cx="44" cy="60" r="2.5" fill="white" />
                                                <circle cx="56" cy="60" r="2.5" fill="white" />
                                                <circle cx="50" cy="72" r="2.5" fill="white" />
                                            </g>
                                        </svg>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <div class="flex justify-between items-center mb-3">
                                            <div class="flex flex-col">
                                                <span class="text-[11px] font-black text-[var(--brand-primary)] uppercase tracking-wider leading-none">La Primitiva</span>
                                                <span class="text-[9px] font-bold text-gray-300 uppercase tracking-tighter mt-1">Sorteo ordinario</span>
                                            </div>
                                            <span class="text-[10px] font-black text-gray-500 bg-gray-100/80 px-3 py-1 rounded-lg">@draw.Date.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("es-ES"))</span>
                                        </div>
                                        
                                        <div class="flex items-center gap-2 mb-4">
                                            <div class="flex gap-1.5 px-3 py-2 bg-gray-50 rounded-xl border border-gray-100/50">
                                                @foreach (var n in draw.Numbers)
                                                {
                                                    <span class="h-7 w-7 rounded-lg bg-[var(--brand-primary)] flex items-center justify-center text-[11px] font-bold text-white shadow-sm shadow-[var(--brand-primary)]/20 transition-transform group-hover:scale-105">@n</span>
                                                }
                                            </div>
                                            <div class="flex gap-1.5 ml-1">
                                                <div class="flex flex-col items-center gap-1">
                                                    <span class="h-7 w-7 rounded-lg bg-[var(--brand-accent)]/10 flex items-center justify-center text-[11px] font-bold text-[var(--brand-accent)] border border-[var(--brand-accent)]/30">@draw.Complementary</span>
                                                    <span class="text-[8px] font-black text-[var(--brand-accent)]/60 text-center uppercase tracking-tighter">C</span>
                                                </div>
                                                <div class="flex flex-col items-center gap-1">
                                                    <span class="h-7 w-7 rounded-lg bg-blue-50 flex items-center justify-center text-[11px] font-bold text-blue-500 border border-blue-100">@draw.Reintegro</span>
                                                    <span class="text-[8px] font-black text-blue-300 text-center uppercase tracking-tighter">R</span>
                                                </div>
                                            </div>
                                        </div>

                                        @if (draw.Joker.HasValue)
                                        {
                                            <div class="py-2.5 px-4 bg-gradient-to-r from-[var(--brand-accent)]/10 to-transparent rounded-xl flex items-center justify-between border border-[var(--brand-accent)]/20 group/joker transition-all hover:from-[var(--brand-accent)]/20">
                                                <div class="flex items-center gap-2">
                                                    <div class="w-1.5 h-1.5 rounded-full bg-[var(--brand-accent)] animate-pulse"></div>
                                                    <span class="text-[10px] font-black text-[var(--brand-accent)] uppercase tracking-wider">Joker</span>
                                                </div>
                                                <span class="text-xs font-black text-gray-700 tracking-[0.3em] font-mono group-hover/joker:tracking-[0.4em] transition-all">@draw.Joker</span>
                                            </div>
                                        }

                                        <button @onclick="() => SaveToHistory(draw)" @onclick:stopPropagation="true" class="mt-4 w-full py-2.5 bg-gray-50 hover:bg-[var(--brand-primary)] text-[var(--brand-primary)] hover:text-white border border-[var(--brand-primary)]/10 hover:border-transparent rounded-xl text-[10px] font-black uppercase tracking-widest transition-all duration-300 flex items-center justify-center gap-2 group/save">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 group-hover/save:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
                                            </svg>
                                            Guardar en Histórico
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            
            <!-- Footer -->
            <div class="p-6 bg-white border-t border-gray-50 flex items-center gap-3">
                <NavLink href="historico" @onclick="() => _showNotifications = false" class="flex-1 py-4 bg-[var(--brand-accent)] hover:bg-[var(--brand-accent)]/90 text-white text-[11px] font-black rounded-xl transition-all shadow-xl shadow-[var(--brand-accent)]/20 flex items-center justify-center gap-3 uppercase tracking-[0.2em] group/footer border border-[var(--brand-accent)]/10">
                    Ver Histórico
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                </NavLink>
            </div>
        </div>
    }
}

@code {
    private bool _isCollapsed = false;
    private bool _isHovered = false;
    private bool _showMobileMenu = false;
    private bool _showRightMobileMenu = false;
    private bool _isDashboard = false;
    private bool _isHistoricalPage = false;
    private bool _showNotifications = false;
    private List<int>? _availableYears;
    
    // Feedback state
    private string? _feedbackMessage;
    private bool _isFeedbackError;
    private System.Threading.Timer? _feedbackTimer;

    protected override async Task OnInitializedAsync()
    {
        GlobalState.OnChange += HandleStateChange;
        NavigationManager.LocationChanged += HandleLocationChanged;
        _isDashboard = IsDashboard(NavigationManager.Uri);
        _isHistoricalPage = IsHistoricalPage(NavigationManager.Uri);
        await LoadYears();
    }

    private void ToggleNotifications()
    {
        _showNotifications = !_showNotifications;
        if (_showNotifications)
        {
            _showMobileMenu = false;
        }
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await NotificationService.CheckForNewDrawsAsync();
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var isDash = IsDashboard(e.Location);
        var isHist = IsHistoricalPage(e.Location);
        bool changed = false;

        if (_isDashboard != isDash)
        {
            _isDashboard = isDash;
            changed = true;
            
            if (!_isDashboard && GlobalState.IsHistoricalView)
            {
                GlobalState.IsHistoricalView = false;
            }
        }

        if (_isHistoricalPage != isHist)
        {
            _isHistoricalPage = isHist;
            changed = true;
        }

        if (changed)
        {
            StateHasChanged();
        }
    }

    private bool IsDashboard(string uri)
    {
        var relative = NavigationManager.ToBaseRelativePath(uri);
        return string.IsNullOrEmpty(relative) || relative == "/";
    }

    private bool IsHistoricalPage(string uri)
    {
        var relative = NavigationManager.ToBaseRelativePath(uri);
        return relative.StartsWith("historico");
    }

    private async void HandleStateChange()
    {
        await InvokeAsync(async () => 
        {
            await LoadYears();
            StateHasChanged();
        });
    }

    private async Task LoadYears()
    {
        using var scope = ScopeFactory.CreateScope();
        var planService = scope.ServiceProvider.GetRequiredService<PlanService>();
        _availableYears = await planService.GetAvailableYearsAsync();
    }

    private void ToggleSidebar()
    {
        _isCollapsed = !_isCollapsed;
    }

    private void ToggleMobileMenu()
    {
        _showMobileMenu = !_showMobileMenu;
        if (_showMobileMenu) _showRightMobileMenu = false;
    }

    private void ToggleRightMobileMenu()
    {
        _showRightMobileMenu = !_showRightMobileMenu;
        if (_showRightMobileMenu) _showMobileMenu = false;
    }

    private void CloseAllMenus()
    {
        _showMobileMenu = false;
        _showRightMobileMenu = false;
        _showNotifications = false;
    }

    private void ToggleRightSidebar()
    {
        // Removed logic for fixed sidebar
    }

    private void SetHistorical(bool historical)
    {
        GlobalState.IsHistoricalView = historical;
    }

    private async Task SaveToHistory(RssDraw draw)
    {
        using var scope = ScopeFactory.CreateScope();
        var winningDrawService = scope.ServiceProvider.GetRequiredService<IWinningDrawService>();
        
        var result = await winningDrawService.SaveFromRssAsync(draw);
        
        if (result.IsSuccess)
        {
            ShowFeedback("Sorteo guardado correctamente en el histórico.", false);
            // 1. First refresh the notification list (this hits the DB)
            await NotificationService.CheckForNewDrawsAsync();
            // 2. Then notify other components to reload their data
            GlobalState.NotifyDataChanged();
        }
        else
        {
            ShowFeedback(result.Error ?? "Error al guardar el sorteo.", true);
        }
    }

    private void ShowFeedback(string message, bool isError)
    {
        _feedbackMessage = message;
        _isFeedbackError = isError;
        StateHasChanged();

        _feedbackTimer?.Dispose();
        _feedbackTimer = new System.Threading.Timer(_ => 
        {
            InvokeAsync(() => 
            {
                _feedbackMessage = null;
                StateHasChanged();
            });
        }, null, 5000, System.Threading.Timeout.Infinite);
    }


    public void Dispose()
    {
        GlobalState.OnChange -= HandleStateChange;
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
