<div class="relative overflow-hidden p-6 rounded-3xl border shadow-sm flex flex-col gap-1 transition-all duration-300 hover:shadow-md @GetCardStyles()">
    <div class="text-xs font-bold uppercase tracking-wider opacity-60">@Title</div>
    <div class="text-3xl font-black">@Value</div>
    @if (!string.IsNullOrEmpty(SubValue))
    {
        <div class="text-sm font-semibold opacity-80">
            @SubValue
        </div>
    }
    
    <div class="absolute -bottom-2 -right-2 w-20 h-20 opacity-10 transform -rotate-12">
        @Icon
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string? SubValue { get; set; }
    [Parameter] public bool IsPositive { get; set; } = true;
    [Parameter] public string Color { get; set; } = "blue";
    [Parameter] public RenderFragment? Icon { get; set; }

    private string GetCardStyles() => Color.ToLower() switch
    {
        "red" => "bg-rose-50 border-rose-200 text-rose-900",
        "emerald" => "bg-emerald-50 border-emerald-200 text-emerald-900",
        "orange" => "bg-orange-50 border-orange-200 text-orange-900",
        "violet" => "bg-violet-50 border-violet-200 text-violet-900",
        _ => "bg-white border-slate-100 text-slate-900"
    };
}
