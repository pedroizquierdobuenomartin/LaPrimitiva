                                        <div class="bg-[var(--brand-bg)] rounded-2xl p-3 md:p-4 space-y-2 md:space-y-4">
                                            <div class="flex justify-between items-center text-[8px] md:text-[10px] font-bold">
                                                <span class="text-[var(--brand-text-secondary)]/50">@L["TotalCostLabel"]:</span>
                                                <span class="text-[var(--brand-secondary)]">@draw.TotalCoste.ToString("N2")€</span>
                                            </div>
                                            <div class="flex justify-between items-center text-[8px] md:text-[10px] font-bold">
                                                <span class="text-[var(--brand-primary)]">@L["TotalPrizesLabel"]:</span>
                                                <span class="text-[var(--brand-primary)]">@draw.TotalPremios.ToString("N2")€</span>
                                            </div>
                                            <div class="pt-1 md:pt-2 border-t border-[var(--brand-borders)] flex justify-between items-center">
                                                <span class="text-[8px] md:text-[10px] font-bold text-[var(--brand-text-secondary)]">@L["NetDrawLabel"]:</span>
                                                <span class="text-base md:text-xl font-bold @(draw.Neto >= 0 ? "text-[var(--brand-positive)]" : "text-[var(--brand-negativo)]")">@draw.Neto.ToString("N2")€</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Notes -->
                                    <div class="space-y-3 md:space-y-4">
                                        <div class="text-[9px] md:text-[10px] font-bold text-[var(--brand-text-secondary)] uppercase tracking-widest px-1">Observaciones</div>
                                        <textarea @bind="draw.Notes" class="w-full bg-[var(--brand-bg)] border-none rounded-xl md:rounded-2xl p-3 md:p-4 text-[10px] md:text-[11px] font-medium text-[var(--brand-text-secondary)] focus:ring-2 focus:ring-[var(--brand-primary)]/20 h-20 md:h-28 resize-none transition-all" placeholder="Notas de auditoría..."></textarea>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-24 bg-[var(--brand-bg)] rounded-[3rem] border-4 border-dashed border-[var(--brand-borders)] flex flex-col items-center">
                        <div class="h-24 w-24 rounded-full bg-white flex items-center justify-center text-[var(--brand-borders)] mb-8 shadow-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                            </svg>
                        </div>
                        <p class="text-lg font-bold text-[var(--brand-text-secondary)] uppercase tracking-widest">@L["EnterWeekNumberPrompt"]</p>
                        <p class="text-[var(--brand-text-secondary)]/50 mt-2 font-medium">@L["ClickLoadDataPrompt"]</p>
