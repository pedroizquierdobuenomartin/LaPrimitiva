@page "/planes"
@using LaPrimitiva.Application.Services
@using LaPrimitiva.Application.DTOs
@using LaPrimitiva.Domain.Entities
@using LaPrimitiva.Domain.Exceptions
@using Microsoft.Extensions.Localization
@using LaPrimitiva.Domain.Localization
@inject IStringLocalizer<PlansResource> L
@inject IStringLocalizer<GlobalResource> LG
@inject GlobalState GlobalState
@inject PlanService PlanService
@inject DrawGenerationService DrawGenService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<Plans> Logger
@implements IDisposable

<PageTitle>@L["Plans"] - La Primitiva Audit</PageTitle>

<div class="space-y-10 animate-in fade-in duration-700">
    <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-4">
        <div>
            <h2 class="text-3xl md:text-4xl font-bold text-[var(--brand-secondary)] tracking-tight">@L["PlanManagement"]</h2>
            <p class="text-[var(--brand-text-secondary)] mt-2 font-medium text-sm md:text-base">@PlanPageDescription</p>
        </div>
        <button @onclick="ShowCreateModal" class="bg-[var(--brand-accent)] hover:opacity-90 text-white md:px-8 md:py-3.5 px-6 py-3 rounded-xl font-bold shadow-xl shadow-[var(--brand-accent)]/20 transition-all flex items-center justify-center gap-2 transform hover:scale-105 active:scale-95 whitespace-nowrap text-sm md:text-base w-full md:w-auto">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            @L["NewPlan"]
        </button>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-10">
        @if (plans == null)
        {
            <div class="flex justify-center p-32 col-span-2">
                <div class="animate-spin rounded-full h-16 w-16 border-4 border-[var(--brand-bg)] border-t-[var(--brand-primary)]"></div>
            </div>
        }
        else if (!plans.Any())
        {
            <div class="col-span-2 py-32 bg-white rounded-[var(--radius-card)] border-2 border-dashed border-[var(--brand-borders)] flex flex-col items-center justify-center text-center">
                <div class="h-24 w-24 bg-[var(--brand-bg)] rounded-full flex items-center justify-center text-[var(--brand-borders)] mb-6">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                    </svg>
                </div>
                <h4 class="text-2xl font-bold text-[var(--brand-secondary)]">@EmptyPlansTitle</h4>
                <p class="text-[var(--brand-text-secondary)] font-medium max-w-sm mt-2">@EmptyPlansDescription</p>
            </div>
        }
        else
        {
            @foreach (var plan in plans)
            {
                <div class="@(plan.HasOverlap ? "bg-rose-50/30 border-rose-200" : "bg-white border-[var(--brand-borders)]") rounded-[var(--radius-card)] border shadow-sm overflow-hidden flex flex-col hover:shadow-xl transition-all duration-300 relative group">
                    @if (plan.HasOverlap)
                    {
                        <div class="absolute top-0 right-0 bg-[var(--brand-negativo)] text-white text-[10px] font-black px-4 py-1.5 rounded-bl-2xl uppercase tracking-widest flex items-center gap-2 shadow-lg z-10 transition-transform group-hover:scale-105">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                            </svg>
                            <h3 class="text-xs font-black">@L["OverlappingDates"]</h3>
                        </div>
                    }

                    <div class="p-6 md:p-8 border-b @(plan.HasOverlap ? "border-rose-100 bg-rose-50/20" : "border-[var(--brand-bg)] bg-[var(--brand-bg)]/40") flex justify-between items-start">
                        <div>
                            <div class="flex items-center gap-2">
                                <h3 class="text-xl md:text-2xl font-bold text-[var(--brand-secondary)]">@plan.Name</h3>
                            </div>
                            <div class="text-xs md:text-sm font-bold @(plan.HasOverlap ? "text-rose-600" : "text-[var(--brand-text-secondary)]") mt-2 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                                <span class="tracking-tight">@plan.EffectiveFrom.ToString("dd MMM yyyy") - @(plan.EffectiveTo?.ToString("dd MMM yyyy") ?? "∞")</span>
                            </div>
                        </div>
                        <div class="flex gap-2 md:gap-3">
                            <button @onclick="() => ShowEditModal(plan)" class="h-9 w-9 md:h-10 md:w-10 bg-white text-[var(--brand-text-secondary)] rounded-xl border border-[var(--brand-borders)] hover:text-[var(--brand-secondary)] hover:border-[var(--brand-secondary)] shadow-sm transition-all flex items-center justify-center group/btn" title="@LG["Edit"]">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                            </button>
                            <button @onclick="() => DeletePlan(plan)" class="h-9 w-9 md:h-10 md:w-10 bg-white text-rose-500 rounded-xl border border-rose-100 hover:bg-rose-500 hover:text-white shadow-sm transition-all flex items-center justify-center" title="@LG["Delete"]">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-4v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                            </button>
                        </div>
                    </div>
                    
                    <div class="p-6 md:p-8 grid grid-cols-2 gap-6 md:gap-8 flex-1 bg-white">
                        <div class="col-span-2 space-y-6">
                            <!-- Statistics Grid -->
                            <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4">
                                <!-- Row 1 -->
                                <div class="p-4 bg-purple-50 rounded-2xl text-center transition-transform hover:scale-105">
                                    <div class="text-[10px] font-bold text-purple-400 uppercase tracking-widest mb-1">@L["Played"]</div>
                                    <div class="text-lg md:text-xl font-bold">@plan.ActiveDraws</div>
                                </div>
                                <div class="p-4 bg-rose-50 rounded-2xl text-center transition-transform hover:scale-105">
                                    <div class="text-[10px] font-bold text-rose-400 uppercase tracking-widest mb-1">@L["TotalCost"]</div>
                                    <div class="text-xl font-bold text-rose-700">@plan.TotalInvested.ToString("N2")€</div>
                                </div>
                                <div class="p-4 bg-emerald-50 rounded-2xl text-center transition-transform hover:scale-105">
                                    <div class="text-[10px] font-bold text-emerald-400 uppercase tracking-widest mb-1">@L["Prizes"]</div>
                                    <div class="text-xl font-bold text-emerald-700">@plan.TotalPrizesAmount.ToString("N2")€</div>
                                </div>

                                <!-- Row 2 -->
                                <div class="p-4 bg-emerald-50 rounded-2xl text-center transition-transform hover:scale-105">
                                    <div class="text-[10px] font-bold text-emerald-400 uppercase tracking-widest mb-1">@L["WinningBets"]</div>
                                    <div class="text-xl font-bold text-emerald-700">@plan.WinningBetsCount</div>
                                </div>
                                <div class="p-4 bg-amber-50 rounded-2xl text-center transition-transform hover:scale-105">
                                    <div class="text-[10px] font-bold text-amber-400 uppercase tracking-widest mb-1">@L["Pending"]</div>
                                    <div class="text-xl font-bold text-amber-700">@plan.InactiveDraws</div>
                                </div>
                                <div class="p-4 bg-[var(--brand-bg)] rounded-2xl text-center transition-transform hover:scale-105">
                                    <div class="text-[10px] font-bold text-[var(--brand-text-secondary)] uppercase tracking-widest mb-1">@L["Totals"]</div>
                                    <div class="text-xl font-bold text-[var(--brand-secondary)]">@plan.TotalDraws</div>
                                </div>
                            </div>
                            
                            <!-- Overall Performance -->
                            <div class="p-5 md:p-6 @(plan.NetBalance > 0 ? "bg-[var(--brand-positive)]" : plan.NetBalance < 0 ? "bg-[var(--brand-negativo)]" : "bg-slate-500") rounded-2xl shadow-lg flex justify-between items-center transform transition-all hover:-translate-y-1">
                                <div>
                                    <div class="text-[10px] font-bold text-white/70 uppercase tracking-widest">@L["NetBalance"]</div>
                                    <div class="text-xl md:text-2xl font-bold text-white tracking-tight">@plan.NetBalance.ToString("N2")€</div>
                                </div>
                                <div class="h-10 w-10 md:h-12 md:w-12 bg-white/20 rounded-xl flex items-center justify-center backdrop-blur-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 md:h-7 md:w-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        @if (plan.NetBalance > 0)
                                        {
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                                        }
                                        else if (plan.NetBalance < 0)
                                        {
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 17h8m0 0v-8m0 8l-8-8-4 4-6-6" />
                                        }
                                        else
                                        {
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M20 12H4" />
                                        }
                                    </svg>
                                </div>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-4 md:gap-6 col-span-2 pt-6 border-t border-[var(--brand-bg)]">
                            <div class="space-y-1">
                                <div class="text-[10px] font-bold text-[var(--brand-text-secondary)] uppercase tracking-widest">@L["Bets"]</div>
                                <div class="text-xs md:text-sm font-bold text-[var(--brand-secondary)] flex items-center gap-2">
                                    <div class="h-2.5 w-2.5 rounded-full bg-[var(--brand-positive)]"></div>
                                    @string.Format(L["DrawsFijoAuto"], plan.BetsPerDraw)
                                </div>
                            </div>
                            <div class="space-y-1">
                                <div class="text-[10px] font-bold text-[var(--brand-text-secondary)] uppercase tracking-widest">Joker</div>
                                <div class="text-xs md:text-sm font-bold @(plan.EnableJoker ? "text-blue-700" : "text-slate-400") flex items-center gap-2">
                                    <div class="h-2.5 w-2.5 rounded-full @(plan.EnableJoker ? "bg-blue-600" : "bg-slate-300")"></div>
                                    @(plan.EnableJoker ? $"{L["Active"]} ({plan.JokerCostPerBet:N2}€)" : L["Inactive"])
                                </div>
                            </div>
                            <div class="col-span-2">
                                <div class="text-[10px] font-bold text-[var(--brand-text-secondary)] uppercase tracking-widest">@L["Label"]</div>
                                <div class="text-xs md:text-sm text-[var(--brand-secondary)] italic font-medium truncate">"@plan.FixedCombinationLabel"</div>
                            </div>
                        </div>
                    </div>

                    @if (plan.HasOverlap)
                    {
                        <div class="px-8 py-4 bg-rose-50 border-t border-rose-100/50 flex items-start gap-4">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-rose-600 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                            <p class="text-xs font-bold text-rose-800 leading-normal">
                                @L["OverlapWarning"]
                            </p>
                        </div>
                    }
                    
                    <div class="p-6 bg-[var(--brand-bg)] flex flex-col sm:flex-row justify-between items-center gap-4">
                        <span class="text-[10px] font-bold text-[var(--brand-text-secondary)] uppercase tracking-widest text-center sm:text-left">@string.Format(L["CreatedOn"], plan.CreatedAt.ToString("g"))</span>
                        <button @onclick="() => HandlePlanAction(plan)" class="w-full sm:w-auto px-6 py-2.5 rounded-xl text-xs font-bold @(plan.HasDraws ? "bg-white text-[var(--brand-accent)] border border-[var(--brand-borders)] hover:border-[var(--brand-accent)]" : "bg-[var(--brand-accent)] text-white hover:opacity-90") transition-all active:scale-95 shadow-sm uppercase tracking-wider">
                            @(plan.HasDraws ? L["ViewDraws"] : L["GenerateDraws"])
                        </button>
                    </div>
                </div>
            }
        }
    </div>
</div>

@if (showModal)
{
    <div class="fixed inset-0 bg-[var(--brand-secondary)]/60 backdrop-blur-md z-[100] flex items-center justify-center p-2 md:p-4 animate-in fade-in duration-300">
        <div class="bg-white rounded-[1.5rem] md:rounded-[2rem] shadow-2xl w-full max-w-lg overflow-hidden border border-[var(--brand-borders)] transform animate-in zoom-in-95 duration-300 flex flex-col max-h-[100dvh] md:max-h-[92vh]">
            <div class="p-6 md:p-10 border-b border-[var(--brand-bg)] flex justify-between items-center bg-white relative">
                <div>
                    <h3 class="text-2xl md:text-3xl font-bold text-[var(--brand-secondary)]">@(isEditing ? L["EditPlan"] : L["NewPlan"])</h3>
                    <p class="text-[10px] md:text-xs font-bold uppercase tracking-[0.2em] mt-1 md:mt-2">@L["PlanConfigSubtitle"]</p>
                </div>
                <button @onclick="() => showModal = false" class="h-10 w-10 md:h-12 md:w-12 rounded-xl md:rounded-2xl flex items-center justify-center text-slate-300 hover:text-[var(--brand-secondary)] hover:bg-[var(--brand-bg)] transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 md:h-7 md:w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="mx-10 mt-8 p-5 bg-rose-50 border border-rose-100 rounded-2xl flex gap-4 items-center animate-in slide-in-from-top-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-rose-500 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                    </svg>
                    <div class="flex-1">
                        <p class="text-sm font-bold text-rose-800">@errorMessage</p>
                        @if (_hasConcurrencyConflict)
                        {
                            <button type="button" @onclick="ReloadPlanAsync" class="mt-3 text-xs font-black uppercase tracking-widest text-rose-700 underline">
                                Recargar datos actuales
                            </button>
                        }
                    </div>
                </div>
            }
            <div class="p-6 md:p-10 space-y-6 md:space-y-8 bg-[var(--brand-bg)]/30 overflow-auto flex-1">
                <div>
                    <label class="block text-[9px] md:text-[10px] font-bold text-[var(--brand-text-secondary)] uppercase tracking-[0.2em] mb-2 md:mb-3 px-1">@L["Name"]</label>
                    <input required @bind="newPlan.Name" class="w-full bg-white border border-[var(--brand-borders)] rounded-xl md:rounded-2xl p-4 md:p-5 text-sm md:text-base font-bold text-[var(--brand-secondary)] focus:ring-4 focus:ring-[var(--brand-primary)]/10 focus:border-[var(--brand-primary)] outline-none transition-all shadow-sm" placeholder="@L["FixedCombinationPlaceholder"]" />
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
                    <div>
                        <label class="block text-[9px] md:text-[10px] font-bold text-[var(--brand-text-secondary)] uppercase tracking-[0.2em] mb-2 md:mb-3 px-1">@L["From"]</label>
                        <input type="date" required @bind="newPlan.EffectiveFrom" class="w-full bg-white border border-[var(--brand-borders)] rounded-xl md:rounded-2xl p-4 md:p-5 text-sm font-bold text-[var(--brand-secondary)] focus:border-[var(--brand-primary)] outline-none transition-all shadow-sm" />
                    </div>
                    <div>
                        <label class="block text-[9px] md:text-[10px] font-bold text-[var(--brand-text-secondary)] uppercase tracking-[0.2em] mb-2 md:mb-3 px-1">@L["To"]</label>
                        <input type="date" @bind="newPlan.EffectiveTo" class="w-full bg-white border border-[var(--brand-borders)] rounded-xl md:rounded-2xl p-4 md:p-5 text-sm font-bold text-[var(--brand-secondary)] focus:border-[var(--brand-primary)] outline-none transition-all shadow-sm" />
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
                    <div>
                        <label class="block text-[9px] md:text-[10px] font-bold text-[var(--brand-text-secondary)] uppercase tracking-[0.2em] mb-2 md:mb-3 px-1">@L["CostPerBetLabel"]</label>
                        <input type="number" min="0" step="0.01" required @bind="newPlan.CostPerBet" class="w-full bg-white border border-[var(--brand-borders)] rounded-xl md:rounded-2xl p-4 md:p-5 text-sm font-bold text-[var(--brand-secondary)] focus:border-[var(--brand-primary)] outline-none transition-all shadow-sm" />
                    </div>
                    <div>
                        <label class="block text-[9px] md:text-[10px] font-bold text-[var(--brand-text-secondary)] uppercase tracking-[0.2em] mb-2 md:mb-3 px-1">@L["CostJokerLabel"]</label>
                        <input type="number" min="0" step="0.01" required @bind="newPlan.JokerCostPerBet" disabled="@(!newPlan.EnableJoker)" class="w-full bg-white border border-[var(--brand-borders)] rounded-xl md:rounded-2xl p-4 md:p-5 text-sm font-bold text-[var(--brand-secondary)] focus:border-[var(--brand-primary)] outline-none transition-all shadow-sm disabled:bg-[var(--brand-bg)] disabled:text-slate-400" />
                    </div>
                </div>
                <div>
                    <label class="block text-[9px] md:text-[10px] font-bold text-[var(--brand-text-secondary)] uppercase tracking-[0.2em] mb-2 md:mb-3 px-1">@L["BetsPerDraw"]</label>
                    <input type="number" min="@Plan.MinBetsPerDraw" max="@Plan.MaxBetsPerDraw" step="1" required @bind="newPlan.BetsPerDraw" class="w-full bg-white border border-[var(--brand-borders)] rounded-xl md:rounded-2xl p-4 md:p-5 text-sm font-bold text-[var(--brand-secondary)] focus:border-[var(--brand-primary)] outline-none transition-all shadow-sm" />
                </div>
                <div>
                    <label class="block text-[9px] md:text-[10px] font-bold text-[var(--brand-text-secondary)] uppercase tracking-[0.2em] mb-2 md:mb-3 px-1">@L["FixedCombinationLabelPrompt"]</label>
                    <input @bind="newPlan.FixedCombinationLabel" class="w-full bg-white border border-[var(--brand-borders)] rounded-xl md:rounded-2xl p-4 md:p-5 text-sm md:text-base font-bold text-[var(--brand-secondary)] focus:border-[var(--brand-primary)] outline-none transition-all shadow-sm" placeholder="@L["FixedCombinationPlaceholder"]" />
                </div>
                <div class="flex items-center gap-4 py-2 px-1">
                    <label class="relative inline-flex items-center cursor-pointer group">
                        <input type="checkbox" @bind="newPlan.EnableJoker" class="sr-only peer">
                        <div class="w-12 md:w-14 h-7 md:h-8 bg-slate-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-[var(--brand-primary)]/20 rounded-full peer peer-checked:after:translate-x-5 md:peer-checked:after:translate-x-6 peer-checked:after:border-white after:content-[''] after:absolute after:top-[4px] after:left-[4px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 md:after:h-6 after:w-5 md:after:w-6 after:transition-all peer-checked:bg-[var(--brand-primary)] shadow-inner"></div>
                        <span class="ml-4 text-xs md:text-sm font-bold text-[var(--brand-secondary)] uppercase tracking-wider group-hover:text-[var(--brand-primary)] transition-colors">@L["EnableJokerLabel"]</span>
                    </label>
                </div>
            </div>
            <div class="p-6 md:p-10 bg-white flex flex-col md:flex-row gap-4 md:gap-6 border-t border-[var(--brand-bg)]">
                <button @onclick="SavePlan" class="w-full md:flex-1 bg-[var(--brand-secondary)] hover:bg-black text-white font-bold py-4 md:py-5 rounded-xl md:rounded-2xl shadow-xl transition-all uppercase tracking-widest text-xs md:text-sm active:scale-95 order-1 md:order-1">@L["SavePlan"]</button>
                <button @onclick="() => showModal = false" class="w-full md:flex-1 bg-[var(--brand-bg)] text-[var(--brand-text-secondary)] font-bold py-4 md:py-5 rounded-xl md:rounded-2xl hover:bg-[var(--brand-borders)] transition-all uppercase tracking-widest text-xs md:text-sm active:scale-95 order-2 md:order-2">@LG["CancelButton"]</button>
            </div>
        </div>
    </div>
}

@if (_planToDelete != null)
{
    <div class="fixed inset-0 z-[110] flex items-center justify-center p-4 bg-[var(--brand-secondary)]/80 backdrop-blur-sm transition-all animate-in fade-in duration-300">
        <div class="bg-white rounded-[1.5rem] md:rounded-[2rem] shadow-2xl w-full max-w-md overflow-hidden animate-in zoom-in duration-300 p-6 md:p-10 text-center space-y-6 md:space-y-8 border border-[var(--brand-borders)]">
            <div class="h-20 w-20 md:h-24 md:w-24 bg-rose-50 rounded-full flex items-center justify-center mx-auto text-rose-500 shadow-inner">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 md:h-12 md:w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </div>
            
            <div class="space-y-2 md:space-y-4">
                <h3 class="text-xl md:text-2xl font-bold text-[var(--brand-secondary)] tracking-tight">@string.Format(L["DeletePlanConfirmTitle"], _planToDelete.Name)</h3>
                
                @if (_hasLinkedDraws)
                {
                    <div class="p-4 md:p-6 bg-amber-50 border border-amber-100 rounded-xl md:rounded-2xl flex flex-col gap-2 md:gap-3 items-center animate-in slide-in-from-top-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 md:h-10 md:w-10 text-amber-500" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                        </svg>
                        <p class="text-sm md:text-base font-bold text-amber-800 leading-snug">@L["CannotDeletePlan"]</p>
                        <p class="text-xs md:text-sm text-amber-700 font-medium">@L["CannotDeletePlanDesc"]</p>
                    </div>
                }
                else if (!string.IsNullOrEmpty(_deleteErrorMessage))
                {
                    <div class="p-4 md:p-6 bg-rose-50 border border-rose-100 rounded-xl md:rounded-2xl flex flex-col gap-2 md:gap-3 items-center animate-in slide-in-from-top-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 md:h-10 md:w-10 text-rose-500" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                        </svg>
                        <p class="text-sm md:text-base font-bold text-rose-800 leading-snug">@LG["Error"]</p>
                        <p class="text-xs md:text-sm text-rose-700 font-medium">@_deleteErrorMessage</p>
                    </div>
                }
                else
                {
                    <p class="text-[var(--brand-text-secondary)] text-sm md:text-base leading-relaxed font-medium">
                        @L["DeletePlanWarningText"]
                    </p>
                    <div class="bg-rose-50 px-3 py-1.5 md:px-4 md:py-2 rounded-xl inline-block">
                        <span class="text-rose-600 font-bold text-[10px] md:text-sm">@L["DeletePlanIrreversible"]</span>
                    </div>
                }
            </div>

            <div class="grid @(_hasLinkedDraws ? "grid-cols-1" : "grid-cols-2") gap-3 md:gap-4 pt-2 md:pt-4">
                <button @onclick="CancelDelete" class="px-4 md:px-6 py-3 md:py-4 rounded-xl md:rounded-2xl text-xs md:text-sm font-bold text-[var(--brand-text-secondary)] bg-[var(--brand-bg)] hover:bg-[var(--brand-borders)] transition-all uppercase tracking-widest active:scale-95">
                    @(_hasLinkedDraws ? L["Understood"] : LG["CancelButton"])
                </button>
                @if (!_hasLinkedDraws)
                {
                    <button @onclick="ConfirmDelete" class="px-4 md:px-6 py-3 md:py-4 rounded-xl md:rounded-2xl text-xs md:text-sm font-bold text-white bg-rose-600 hover:bg-rose-700 shadow-xl shadow-rose-200 transition-all active:scale-95 uppercase tracking-widest">
                        @LG["ConfirmDeleteButton"]
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<PlanDto>? plans;
    private bool showModal = false;
    private bool isEditing = false;
    private string? errorMessage;
    private bool _hasConcurrencyConflict;
    private Plan newPlan = new Plan { EffectiveFrom = DateTime.Today };
    private PlanDto? _planToDelete;
    private string? _deleteErrorMessage;
    private bool _hasLinkedDraws;
    private bool _isLoading;
    private bool _disposed;
    private string PlanPageDescription => GlobalState.ShowAllPlans
        ? L["ConfigureAllPlanRules"].Value
        : string.Format("{0} {1}.", L["ConfigurePlanRules"].Value, GlobalState.SelectedYear);
    private string EmptyPlansTitle => GlobalState.ShowAllPlans
        ? L["NoPlansAvailable"].Value
        : string.Format(L["NoPlansForYear"], GlobalState.SelectedYear);
    private string EmptyPlansDescription => GlobalState.ShowAllPlans
        ? L["NoPlansAvailableDesc"].Value
        : L["NoPlansForYearDesc"].Value;

    protected override async Task OnInitializedAsync()
    {
        GlobalState.OnChange += HandleStateChange;
        await LoadData();
    }

    private void HandleStateChange()
    {
        if (_disposed)
        {
            return;
        }

        _ = HandleStateChangeAsync();
    }

    private async Task HandleStateChangeAsync()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                if (_disposed)
                {
                    return;
                }

                await LoadData();
                if (!_disposed)
                {
                    StateHasChanged();
                }
            });
        }
        catch (Exception ex)
        {
            if (!_disposed)
            {
                Logger.LogError(ex, "Error al recargar los planes tras un cambio de estado global.");
            }
        }
    }

    private async Task LoadData()
    {
        if (_isLoading) return;
        _isLoading = true;
        try 
        {
            var loadedPlans = GlobalState.ShowAllPlans
                ? await PlanService.GetPlansAsync()
                : await PlanService.GetPlansByYearAsync(GlobalState.SelectedYear);
            if (!_disposed)
            {
                plans = loadedPlans;
            }
        }
        finally 
        {
            _isLoading = false;
        }
    }

    private void ShowCreateModal()
    {
        errorMessage = null;
        _hasConcurrencyConflict = false;
        isEditing = false;
        var year = GlobalState.SelectedYear;
        newPlan = new Plan 
        { 
            Name = $"Plan {year}", 
            EffectiveFrom = new DateTime(year, 1, 1), 
            EffectiveTo = new DateTime(year, 12, 31) 
        };
        showModal = true;
    }

    private async Task ShowEditModal(PlanDto planDto)
    {
        errorMessage = null;
        _hasConcurrencyConflict = false;
        isEditing = true;
        var plan = await PlanService.GetPlanByIdAsync(planDto.Id);
        if (plan != null)
        {
            // Map DTO to Entity for form binding
            newPlan = new Plan
            {
                Id = plan.Id,
                Name = plan.Name,
                EffectiveFrom = plan.EffectiveFrom,
                EffectiveTo = plan.EffectiveTo,
                CostPerBet = plan.CostPerBet,
                BetsPerDraw = plan.BetsPerDraw,
                EnableJoker = plan.EnableJoker,
                JokerCostPerBet = plan.JokerCostPerBet,
                FixedCombinationLabel = plan.FixedCombinationLabel,
                RowVersion = plan.RowVersion.ToArray()
            };
            showModal = true;
        }
        else 
        {
            await LoadData();
        }
    }

    private async Task SavePlan()
    {
        try 
        {
            errorMessage = null;
            _hasConcurrencyConflict = false;
            if (isEditing)
            {
                await PlanService.UpdatePlanAsync(newPlan);
            }
            else
            {
                await PlanService.CreatePlanAsync(newPlan);
            }
            showModal = false;
            await LoadData();
        }
        catch (ConcurrencyConflictException ex)
        {
            _hasConcurrencyConflict = true;
            errorMessage = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception)
        {
            errorMessage = L["SavePlanError"];
        }
    }

    private async Task ReloadPlanAsync()
    {
        var current = await PlanService.GetPlanByIdAsync(newPlan.Id);
        if (current == null)
        {
            showModal = false;
            await LoadData();
            return;
        }

        newPlan = new Plan
        {
            Id = current.Id,
            Name = current.Name,
            EffectiveFrom = current.EffectiveFrom,
            EffectiveTo = current.EffectiveTo,
            CostPerBet = current.CostPerBet,
            BetsPerDraw = current.BetsPerDraw,
            EnableJoker = current.EnableJoker,
            JokerCostPerBet = current.JokerCostPerBet,
            FixedCombinationLabel = current.FixedCombinationLabel,
            RowVersion = current.RowVersion.ToArray()
        };
        _hasConcurrencyConflict = false;
        errorMessage = null;
    }

    private async Task DeletePlan(PlanDto plan)
    {
        _deleteErrorMessage = null;
        _hasLinkedDraws = plan.HasDraws;
        _planToDelete = plan;
        StateHasChanged();
    }

    private void CancelDelete()
    {
        _planToDelete = null;
        _deleteErrorMessage = null;
        _hasLinkedDraws = false;
    }

    private async Task ConfirmDelete()
    {
        if (_planToDelete == null || _hasLinkedDraws) return;

        try 
        {
            await PlanService.DeletePlanAsync(_planToDelete.Id);
            _planToDelete = null;
            _deleteErrorMessage = null;
            _hasLinkedDraws = false;
            await LoadData();
        }
        catch (InvalidOperationException ex)
        {
            _deleteErrorMessage = ex.Message;
            _hasLinkedDraws = true; // Refresh state if backend rejected it
        }
        catch (Exception)
        {
            _deleteErrorMessage = L["UnexpectedDeleteError"];
        }
    }

    private void HandlePlanAction(PlanDto plan)
    {
        // 2.- Cuando se clique en Generar sorteos (no tiene sorteos) debe llevar a Registro del año del plan.
        // 3.- Cuando se clique en Ver Sorteos debe llevar a Registro con el filtro de la fecha del plan para ver solo los sorteos asociados al plan.
        
        GlobalState.SelectedYear = plan.EffectiveFrom.Year;
        
        if (plan.HasDraws)
        {
            GlobalState.SelectedPlanId = plan.Id;
        }
        else 
        {
            GlobalState.SelectedPlanId = null;
        }
        
        Nav.NavigateTo(AppRoutes.Registration);
    }

    public void Dispose()
    {
        _disposed = true;
        GlobalState.OnChange -= HandleStateChange;
    }
}
