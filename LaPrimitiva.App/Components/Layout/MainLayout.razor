@using LaPrimitiva.Application.Services
@using LaPrimitiva.Domain.Localization
@using Microsoft.Extensions.Localization
@inherits LayoutComponentBase
@inject GlobalState GlobalState
@inject IServiceScopeFactory ScopeFactory
@inject IStringLocalizer<PrimitivaResource> L
@inject NavigationManager NavigationManager
@implements IDisposable

<div class="h-full flex relative bg-[var(--brand-bg)]">
    @if (_showMobileMenu)
    {
        <!-- Mobile Backdrop -->
        <div class="fixed inset-0 bg-black/40 z-40 md:hidden backdrop-blur-sm" @onclick="ToggleMobileMenu"></div>
    }

    <!-- Sidebar -->
    <aside @onmouseenter="() => _isHovered = true" 
           @onmouseleave="() => _isHovered = false"
           class="@((_isCollapsed && !_isHovered) ? "w-20 sidebar-collapsed" : "w-72 shadow-2xl z-[60]") @(_showMobileMenu ? "flex" : "hidden") md:flex bg-[var(--brand-secondary)] text-white/80 flex-shrink-0 flex flex-col transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] fixed inset-y-0 left-0 md:relative md:my-4 md:ml-4 md:rounded-[var(--radius-sidebar)] border-r border-white/5">
        <div class="h-32 flex items-center justify-center border-b border-white/10 flex-shrink-0 relative">
            <div class="flex flex-col items-center w-full gap-3 transition-all duration-500 @((_isCollapsed && !_isHovered) ? "scale-90" : "scale-100")">
                <div class="p-2.5 bg-white/5 rounded-2xl shadow-inner border border-white/5 flex items-center justify-center transition-all hover:bg-white/10 hover:scale-105 active:scale-95">
                    <img src="/images/logo_white.png" class="@((_isCollapsed && !_isHovered) ? "h-7 w-7" : "h-8 w-8") object-contain transition-all duration-500" alt="Logo" />
                </div>
                <div class="overflow-hidden transition-all duration-500 ease-in-out @((_isCollapsed && !_isHovered) ? "max-h-0 opacity-0" : "max-h-10 opacity-100")">
                    <span class="text-[11px] font-bold text-white uppercase tracking-[0.2em] whitespace-nowrap">
                        La <span class="text-[var(--brand-accent)]">P</span>rimitiva
                    </span>
                </div>
            </div>

            <!-- Toggle Button Inside Header -->
            @if (!_isCollapsed || _isHovered)
            {
                <button @onclick="ToggleSidebar" class="absolute right-4 top-4 text-white/40 hover:text-white transition-all z-[70] p-1 rounded-lg hover:bg-white/10" aria-label="Toggle Sidebar">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            }
        </div>

        
        
        <nav class="flex-1 @((_isCollapsed && !_isHovered) ? "px-0" : "px-3") space-y-2 mt-8 overflow-x-hidden scrollbar-hide">
            <NavLink href="" Match="NavLinkMatch.All" class="@($"nav-item w-full flex items-center {(_isCollapsed && !_isHovered ? "justify-center px-0" : "gap-4 px-5 text-left")} py-4 rounded-xl hover:bg-white/10 transition-all duration-300 group text-white/70 relative")" ActiveClass="active-nav bg-white/15 text-white shadow-lg" title="@L["Dashboard"]">
                <div class="flex items-center justify-center w-10 h-10 flex-shrink-0 rounded-lg group-hover:scale-110 transition-transform duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                    </svg>
                </div>
                <div class="overflow-hidden transition-all duration-500 ease-in-out @((_isCollapsed && !_isHovered) ? "w-0 opacity-0" : "w-full opacity-100")">
                    <span class="font-medium tracking-wide whitespace-nowrap">@L["Dashboard"]</span>
                </div>
            </NavLink>

            <NavLink href="register" class="@($"nav-item w-full flex items-center {(_isCollapsed && !_isHovered ? "justify-center px-0" : "gap-4 px-5 text-left")} py-4 rounded-xl hover:bg-white/10 transition-all duration-300 group text-white/70 relative")" ActiveClass="active-nav bg-white/15 text-white shadow-lg" title="@L["Registration"]">
                <div class="flex items-center justify-center w-10 h-10 flex-shrink-0 rounded-lg group-hover:scale-110 transition-transform duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                    </svg>
                </div>
                <div class="overflow-hidden transition-all duration-500 ease-in-out @((_isCollapsed && !_isHovered) ? "w-0 opacity-0" : "w-full opacity-100")">
                    <span class="font-medium tracking-wide whitespace-nowrap">@L["Registration"]</span>
                </div>
            </NavLink>

            <NavLink href="plans" class="@($"nav-item w-full flex items-center {(_isCollapsed && !_isHovered ? "justify-center px-0" : "gap-4 px-5 text-left")} py-4 rounded-xl hover:bg-white/10 transition-all duration-300 group text-white/70 relative")" ActiveClass="active-nav bg-white/15 text-white shadow-lg" title="@L["Plans"]">
                <div class="flex items-center justify-center w-10 h-10 flex-shrink-0 rounded-lg group-hover:scale-110 transition-transform duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                    </svg>
                </div>
                <div class="overflow-hidden transition-all duration-500 ease-in-out @((_isCollapsed && !_isHovered) ? "w-0 opacity-0" : "w-full opacity-100")">
                    <span class="font-medium tracking-wide whitespace-nowrap">@L["Plans"]</span>
                </div>
            </NavLink>

            <NavLink href="data" class="@($"nav-item w-full flex items-center {(_isCollapsed && !_isHovered ? "justify-center px-0" : "gap-4 px-5 text-left")} py-4 rounded-xl hover:bg-white/10 transition-all duration-300 group text-white/70 relative")" ActiveClass="active-nav bg-white/15 text-white shadow-lg" title="@L["Data"]">
                <div class="flex items-center justify-center w-10 h-10 flex-shrink-0 rounded-lg group-hover:scale-110 transition-transform duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a2 2 0 002 2h12a2 2 0 002-2v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                    </svg>
                </div>
                <div class="overflow-hidden transition-all duration-500 ease-in-out @((_isCollapsed && !_isHovered) ? "w-0 opacity-0" : "w-full opacity-100")">
                    <span class="font-medium tracking-wide whitespace-nowrap">@L["Data"]</span>
                </div>
            </NavLink>
        </nav>

        <div class="px-8 pb-8 pt-4 transition-all duration-500 @((_isCollapsed && !_isHovered) ? "opacity-0 scale-50 h-0 overflow-hidden" : "opacity-100 scale-100")">
            <div class="text-[10px] text-white/40 uppercase tracking-widest font-bold whitespace-nowrap">
                &copy; 2026 La Primitiva Audit
            </div>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col min-h-0 transition-all duration-300 ease-in-out">
        <!-- Header -->
        <header class="min-h-20 bg-transparent flex flex-wrap items-center justify-between px-4 md:px-6 py-4 md:py-0 flex-shrink-0 z-10 gap-4">
            <div class="flex items-center gap-6">
                <button @onclick="ToggleMobileMenu" class="md:hidden p-3 text-[var(--brand-secondary)] hover:bg-white/50 rounded-xl transition-all shadow-sm" aria-label="Open Menu">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
                <div class="flex items-center gap-3">
                    <div class="text-xs font-bold text-[var(--brand-text-secondary)] uppercase tracking-[0.2em] hidden sm:block">
                        @L["SelectedYear"]:
                    </div>
                    <div class="relative group">
                        <select @bind="GlobalState.SelectedYear" disabled="@GlobalState.IsHistoricalView" 
                                class="appearance-none bg-white border border-[var(--brand-borders)] text-[var(--brand-secondary)] font-bold text-sm rounded-xl focus:ring-2 focus:ring-[var(--brand-primary)] focus:border-transparent block py-2 px-4 pr-10 disabled:opacity-50 shadow-sm cursor-pointer transition-all hover:border-[var(--brand-primary)]">
                            @if (_availableYears != null)
                            {
                                @foreach (var y in _availableYears)
                                {
                                    <option value="@y">@y</option>
                                }
                            }
                        </select>
                        <div class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-[var(--brand-secondary)]">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="flex items-center gap-4">
                @if (_isDashboard)
                {
                    <div class="flex items-center bg-white/50 p-1 rounded-xl shadow-inner border border-white/40 backdrop-blur-sm scale-90 sm:scale-100 origin-right transition-all">
                        <button @onclick="() => SetHistorical(false)" class="px-3 sm:px-5 py-2 text-[10px] sm:text-xs font-bold rounded-lg transition-all @(!GlobalState.IsHistoricalView ? "bg-[var(--brand-accent)] text-white shadow-lg" : "text-[var(--brand-text-secondary)] hover:text-[var(--brand-secondary)]")">
                            @L["Yearly"]
                        </button>
                        <button @onclick="() => SetHistorical(true)" class="px-3 sm:px-5 py-2 text-[10px] sm:text-xs font-bold rounded-lg transition-all @(GlobalState.IsHistoricalView ? "bg-[var(--brand-accent)] text-white shadow-lg" : "text-[var(--brand-text-secondary)] hover:text-[var(--brand-secondary)]")">
                            @L["Historical"]
                        </button>
                    </div>
                }
                
                <div class="h-10 w-10 rounded-xl bg-white border border-[var(--brand-borders)] shadow-sm flex items-center justify-center text-[var(--brand-primary)] font-bold hover:scale-105 transition-transform cursor-pointer">
                    P
                </div>
            </div>
        </header>

        <!-- Page Content -->
        <div class="flex-1 overflow-auto p-4 md:px-6 md:pt-4 md:pb-10 pb-24">
            @Body
        </div>
    </main>

    <!-- Mobile Bottom Navigation -->
    <nav class="md:hidden fixed bottom-8 left-8 right-8 bg-[var(--brand-secondary)] border border-white/20 rounded-3xl shadow-2xl z-[70] flex p-2 gap-2 h-16">
        <NavLink href="" Match="NavLinkMatch.All" class="flex items-center justify-center flex-1 rounded-2xl transition-all text-white/70 hover:text-white" ActiveClass="bg-[var(--brand-primary)] text-white shadow-xl">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
        </NavLink>
        <NavLink href="register" class="flex items-center justify-center flex-1 rounded-2xl transition-all text-white/70 hover:text-white" ActiveClass="bg-[var(--brand-primary)] text-white shadow-xl">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
            </svg>
        </NavLink>
        <NavLink href="plans" class="flex items-center justify-center flex-1 rounded-2xl transition-all text-white/70 hover:text-white" ActiveClass="bg-[var(--brand-primary)] text-white shadow-xl">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
            </svg>
        </NavLink>
    </nav>
</div>

@code {
    private bool _isCollapsed = false;
    private bool _isHovered = false;
    private bool _showMobileMenu = false;
    private bool _isDashboard = false;
    private List<int>? _availableYears;

    protected override async Task OnInitializedAsync()
    {
        GlobalState.OnChange += HandleStateChange;
        NavigationManager.LocationChanged += HandleLocationChanged;
        _isDashboard = IsDashboard(NavigationManager.Uri);
        await LoadYears();
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var isDash = IsDashboard(e.Location);
        if (_isDashboard != isDash)
        {
            _isDashboard = isDash;
            
            if (!_isDashboard && GlobalState.IsHistoricalView)
            {
                GlobalState.IsHistoricalView = false;
            }

            StateHasChanged();
        }
    }

    private bool IsDashboard(string uri)
    {
        var relative = NavigationManager.ToBaseRelativePath(uri);
        return string.IsNullOrEmpty(relative) || relative == "/";
    }

    private async void HandleStateChange()
    {
        await InvokeAsync(async () => 
        {
            await LoadYears();
            StateHasChanged();
        });
    }

    private async Task LoadYears()
    {
        using var scope = ScopeFactory.CreateScope();
        var planService = scope.ServiceProvider.GetRequiredService<PlanService>();
        _availableYears = await planService.GetAvailableYearsAsync();
    }

    private void ToggleSidebar()
    {
        _isCollapsed = !_isCollapsed;
    }

    private void ToggleMobileMenu()
    {
        _showMobileMenu = !_showMobileMenu;
    }

    private void SetHistorical(bool historical)
    {
        GlobalState.IsHistoricalView = historical;
    }


    public void Dispose()
    {
        GlobalState.OnChange -= HandleStateChange;
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
