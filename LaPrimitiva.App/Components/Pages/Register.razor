                                                    <button @onclick="() => tempModalDraws.Remove(d)" class="h-8 w-8 md:h-10 md:w-10 text-[var(--brand-accent)] hover:text-rose-500 hover:bg-rose-50 rounded-lg md:rounded-xl transition-all flex items-center justify-center">
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 md:h-5 md:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
