@using LaPrimitiva.Application.Interfaces
@inherits ErrorBoundaryBase
@inject IApplicationErrorReporter ErrorReporter

@if (CurrentException is null)
{
    @ChildContent
}
else
{
    <section class="m-6 rounded-2xl border border-rose-200 bg-white p-8 shadow-lg" role="alert">
        <h1 class="text-2xl font-black text-rose-700">No hemos podido completar la operación</h1>
        <p class="mt-3 text-slate-700">
            El detalle técnico se ha registrado de forma segura. Puedes reintentar la operación o volver al inicio.
        </p>
        @if (!string.IsNullOrWhiteSpace(_reference))
        {
            <p class="mt-3 text-sm text-slate-600">
                <strong>Referencia:</strong> <code>@_reference</code>
            </p>
        }
        <div class="mt-6 flex flex-wrap gap-3">
            <button class="rounded-xl bg-emerald-700 px-5 py-3 font-bold text-white" @onclick="Recover">
                Reintentar
            </button>
            <a class="rounded-xl border border-slate-300 px-5 py-3 font-bold text-slate-700" href="/">
                Volver al inicio
            </a>
        </div>
    </section>
}

@code {
    private string? _reference;

    protected override Task OnErrorAsync(Exception exception)
    {
        _reference = ErrorReporter.Report(exception, "BlazorCircuit");
        return Task.CompletedTask;
    }
}
