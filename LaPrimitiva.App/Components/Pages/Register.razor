                                        <div class="text-[9px] md:text-[10px] font-bold text-[var(--brand-text-secondary)] uppercase tracking-widest px-1">@L["AuditedCostsTitle"]</div>
                                        <div class="grid grid-cols-2 sm:grid-cols-1 gap-3">
