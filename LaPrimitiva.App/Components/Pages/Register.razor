                        </div>
                        
                        <div class="max-w-4xl mx-auto space-y-8 md:space-y-12 relative z-10">
                            <div class="text-center space-y-2">
                                <span class="inline-block px-3 py-1 rounded-full bg-[var(--brand-bg)] text-[var(--brand-primary)] text-[8px] md:text-[10px] font-bold uppercase tracking-widest mb-1 md:mb-2">Configurador Inteligente</span>
                                <h4 class="text-2xl md:text-4xl font-bold text-[var(--brand-secondary)] tracking-tight">Personaliza tu Semana</h4>
                                <p class="text-[var(--brand-text-secondary)] font-medium text-sm md:text-lg">Configura el plan de apuestas para la semana @modalWeek.</p>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
