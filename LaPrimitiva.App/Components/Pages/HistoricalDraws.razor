@page "/historico"
@using LaPrimitiva.Application.DTOs
@using LaPrimitiva.Application.Interfaces
@using LaPrimitiva.Application.Services
@using LaPrimitiva.Domain.Localization
@using LaPrimitiva.Domain.Exceptions
@using LaPrimitiva.Domain.Errors
@using Microsoft.Extensions.Localization
@inject IWinningDrawService WinningDrawService
@inject IStringLocalizer<HistoricalResource> L
@inject IStringLocalizer<GlobalResource> LG
@inject IStringLocalizer<ErrorResource> LE
@inject IApplicationErrorReporter ErrorReporter

<PageTitle>@L["Historical"] - La Primitiva Audit</PageTitle>

<div class="fade-in space-y-8 pb-12">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 bg-white p-8 rounded-[var(--radius-card)] shadow-sm border border-[var(--brand-borders)]/50">
        <div class="space-y-2">
            <h1 class="text-3xl font-black text-[var(--brand-secondary)] tracking-tight">@L["HistoricalCombinations"]</h1>
            <p class="text-[var(--brand-text-secondary)] text-sm font-medium">@L["HistoricalCombinationsDesc"]</p>
        </div>
        
        <div class="flex flex-col sm:flex-row items-center gap-4">
            @if (_availableYears != null && _availableYears.Any())
            {
                <div class="flex items-center gap-3 bg-gray-50 px-4 py-2 rounded-xl border border-gray-100">
                    <span class="text-[10px] font-black text-[var(--brand-text-secondary)] uppercase tracking-[0.2em]">@L["Year"]:</span>
                    <select @onchange="OnYearChanged" class="bg-transparent text-sm font-bold text-[var(--brand-secondary)] outline-none cursor-pointer">
                        @foreach (var year in _availableYears)
                        {
                            <option value="@year" selected="@(year == _selectedYear)">@year</option>
                        }
                    </select>
                </div>
            }

            <button @onclick="ShowCreateModal" class="bg-[var(--brand-accent)] hover:opacity-90 text-white px-6 md:px-8 py-3 md:py-3.5 rounded-2xl text-sm font-bold shadow-xl shadow-[var(--brand-accent)]/20 transition-all flex items-center justify-center gap-2 transform hover:scale-105 active:scale-95 w-full sm:w-auto">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                </svg>
                @L["AddNewWinningDraw"]
            </button>
        </div>
    </div>

    @if (_draws == null)
    {
        <div class="flex justify-center items-center py-20">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-[var(--brand-primary)]"></div>
        </div>
    }
    else
    {
        <!-- Desktop Table View -->
        <div class="hidden md:block overflow-hidden rounded-[var(--radius-card)] border border-[var(--brand-borders)]/50 bg-white shadow-xl">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-50/50 border-b border-gray-100">
                        <th class="px-6 py-5 text-[10px] font-black text-[var(--brand-text-secondary)] uppercase tracking-[0.2em]">@LG["Date"]</th>
                        <th class="px-6 py-5 text-[10px] font-black text-[var(--brand-text-secondary)] uppercase tracking-[0.2em] text-center">@L["Numbers"]</th>
                        <th class="px-6 py-5 text-[10px] font-black text-[var(--brand-text-secondary)] uppercase tracking-[0.2em] text-center">@L["Comp"]</th>
                        <th class="px-6 py-5 text-[10px] font-black text-[var(--brand-text-secondary)] uppercase tracking-[0.2em] text-center">@L["Rein"]</th>
                        <th class="px-6 py-5 text-[10px] font-black text-[var(--brand-text-secondary)] uppercase tracking-[0.2em] text-center">@LG["Joker"]</th>
                        <th class="px-6 py-5 text-[10px] font-black text-[var(--brand-text-secondary)] uppercase tracking-[0.2em] text-right">@LG["Data"]</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    @foreach (var draw in _draws)
                    {
                        <tr class="hover:bg-gray-50/50 transition-colors group">
                            <td class="px-6 py-4">
                                <span class="text-sm font-bold text-[var(--brand-secondary)]">@draw.DrawDate.ToString("d")</span>
                                <div class="text-[10px] text-gray-400 font-medium uppercase tracking-tighter">@draw.DrawDate.ToString("dddd")</div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center justify-center gap-1.5">
                                    @foreach (var n in new[] { draw.Number1, draw.Number2, draw.Number3, draw.Number4, draw.Number5, draw.Number6 })
                                    {
                                        <span class="h-8 w-8 rounded-full bg-gray-100 text-[var(--brand-secondary)] flex items-center justify-center text-xs font-black shadow-inner border border-white group-hover:bg-white group-hover:shadow-sm transition-all">@n</span>
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-4 text-center">
                                <span class="inline-flex h-8 w-8 rounded-full bg-blue-50 text-blue-700 items-center justify-center text-xs font-black border border-blue-100/50 shadow-sm">@draw.Complementario</span>
                            </td>
                            <td class="px-6 py-4 text-center">
                                <span class="inline-flex h-8 w-8 rounded-full bg-red-50 text-red-700 items-center justify-center text-xs font-black border border-red-100/50 shadow-sm">@draw.Reintegro</span>
                            </td>
                            <td class="px-6 py-4 text-center">
                                @if (!string.IsNullOrEmpty(draw.Joker))
                                {
                                    <span class="px-3 py-1.5 rounded-lg bg-[var(--brand-accent)]/10 text-[var(--brand-secondary)] text-[10px] font-black border border-[var(--brand-accent)]/20 tracking-widest text-center block max-w-[100px] mx-auto">@draw.Joker</span>
                                }
                                else
                                {
                                    <span class="text-gray-300 text-[10px] font-bold">---</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                    <button @onclick="() => ShowEditModal(draw)" class="p-2 text-gray-400 hover:text-[var(--brand-accent)] transition-colors rounded-lg hover:bg-gray-100" title="@LG["Edit"]">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-5M15.172 3.828a2 2 0 112.828 2.828L11.828 15H9v-2.828l6.172-6.172z" />
                                        </svg>
                                    </button>
                                    <button @onclick="() => ShowDeleteModal(draw)" class="p-2 text-gray-400 hover:text-red-500 transition-colors rounded-lg hover:bg-red-50" title="@LG["Delete"]">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobile Card View -->
        <div class="md:hidden space-y-4">
            @foreach (var draw in _draws)
            {
                <div class="bg-white p-5 rounded-[var(--radius-card)] shadow-sm border border-[var(--brand-borders)]/50 relative overflow-hidden group">
                    <div class="flex items-start justify-between border-b border-gray-50 pb-4 mb-4">
                        <div>
                            <span class="text-xs font-black text-[var(--brand-secondary)]">@draw.DrawDate.ToString("d")</span>
                            <div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider">@draw.DrawDate.ToString("dddd")</div>
                        </div>
                        <div class="flex gap-2">
                             <button @onclick="() => ShowEditModal(draw)" class="p-1.5 text-gray-400 rounded-lg hover:bg-gray-50 active:bg-gray-100 transition-all">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-5M15.172 3.828a2 2 0 112.828 2.828L11.828 15H9v-2.828l6.172-6.172z" />
                                </svg>
                            </button>
                            <button @onclick="() => ShowDeleteModal(draw)" class="p-1.5 text-red-300 rounded-lg hover:bg-red-50 active:bg-red-100 transition-all">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                            </button>
                        </div>
                    </div>
                    
                    <div class="space-y-4">
                        <div class="flex items-center justify-between">
                            <div class="flex flex-wrap gap-1.5 flex-1">
                               @foreach (var n in new[] { draw.Number1, draw.Number2, draw.Number3, draw.Number4, draw.Number5, draw.Number6 })
                                {
                                    <span class="h-9 w-9 rounded-full bg-gray-50 text-[var(--brand-secondary)] flex items-center justify-center text-xs font-black shadow-sm border border-white">@n</span>
                                }
                            </div>
                            <div class="flex gap-1.5 flex-shrink-0 ml-3 border-l border-gray-100 pl-3">
                                <span class="h-9 w-9 rounded-full bg-blue-50 text-blue-700 flex items-center justify-center text-xs font-black border border-blue-100/50 shadow-sm" title="@L["Complementary"]">@draw.Complementario</span>
                                <span class="h-9 w-9 rounded-full bg-red-50 text-red-700 flex items-center justify-center text-xs font-black border border-red-100/50 shadow-sm" title="@L["Reintegro"]">@draw.Reintegro</span>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(draw.Joker))
                        {
                            <div class="pt-3 border-t border-gray-50 flex items-center justify-between">
                                <span class="text-[9px] font-black text-gray-400 uppercase tracking-widest">@LG["Joker"]</span>
                                <span class="px-3 py-1 rounded-lg bg-[var(--brand-accent)]/10 text-[var(--brand-secondary)] text-[10px] font-black border border-[var(--brand-accent)]/20 tracking-widest">@draw.Joker</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (_showModal)
{
    <div class="fixed inset-0 z-[100] flex items-center justify-center p-2 md:p-4 bg-[var(--brand-secondary)]/70 backdrop-blur-md transition-all">
        <div class="bg-white rounded-[1.5rem] md:rounded-[2.5rem] shadow-2xl w-full max-w-lg max-h-[100dvh] md:max-h-[92vh] overflow-hidden flex flex-col animate-in fade-in zoom-in duration-300">
            <!-- Modal Header -->
            <div class="px-6 py-5 md:px-10 md:py-8 border-b border-[var(--brand-borders)] flex justify-between items-center bg-white">
                <div class="flex items-center gap-4">
                    <div class="h-10 w-10 md:h-12 md:w-12 rounded-xl bg-[var(--brand-primary)] flex items-center justify-center text-white shadow-lg shadow-[var(--brand-primary)]/10">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-lg md:text-xl font-bold text-[var(--brand-secondary)] leading-tight">@(_isEditing ? L["EditWinningDraw"] : L["AddNewWinningDraw"])</h3>
                        <p class="text-[10px] md:text-xs text-[var(--brand-text-secondary)] font-medium">@L["ConfigureResults"]</p>
                    </div>
                </div>
                <button @onclick="CloseModal" class="h-10 w-10 hover:bg-[var(--brand-bg)] rounded-xl flex items-center justify-center transition-all text-slate-300 hover:text-[var(--brand-secondary)]">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Modal Content -->
            <div class="flex-1 overflow-auto p-6 md:p-10 bg-[var(--brand-bg)]/30 space-y-6">
                <!-- Date Picker -->
                <div class="space-y-2">
                    <label class="text-[10px] font-black text-[var(--brand-text-secondary)] uppercase tracking-widest ml-1">@LG["Date"]</label>
                    <input type="date" @bind="_editingDraw.DrawDate" class="w-full bg-white border border-[var(--brand-borders)] rounded-xl p-4 text-sm font-bold text-[var(--brand-secondary)] outline-none focus:ring-2 focus:ring-[var(--brand-primary)]/20 transition-all h-14" />
                </div>

                <!-- Numbers Grid -->
                <div class="space-y-3">
                    <label class="text-[10px] font-black text-[var(--brand-text-secondary)] uppercase tracking-widest ml-1">@L["Numbers"]</label>
                    <div class="grid grid-cols-3 md:grid-cols-6 gap-3">
                        <input type="number" min="1" max="49" @bind="_editingDraw.Number1" class="modal-input-circle @(IsDuplicate(_editingDraw.Number1) ? "border-red-500 bg-red-50/30 font-black" : "font-black")" placeholder="1" />
                        <input type="number" min="1" max="49" @bind="_editingDraw.Number2" class="modal-input-circle @(IsDuplicate(_editingDraw.Number2) ? "border-red-500 bg-red-50/30" : "")" placeholder="2" />
                        <input type="number" min="1" max="49" @bind="_editingDraw.Number3" class="modal-input-circle @(IsDuplicate(_editingDraw.Number3) ? "border-red-500 bg-red-50/30" : "")" placeholder="3" />
                        <input type="number" min="1" max="49" @bind="_editingDraw.Number4" class="modal-input-circle @(IsDuplicate(_editingDraw.Number4) ? "border-red-500 bg-red-50/30" : "")" placeholder="4" />
                        <input type="number" min="1" max="49" @bind="_editingDraw.Number5" class="modal-input-circle @(IsDuplicate(_editingDraw.Number5) ? "border-red-500 bg-red-50/30" : "")" placeholder="5" />
                        <input type="number" min="1" max="49" @bind="_editingDraw.Number6" class="modal-input-circle @(IsDuplicate(_editingDraw.Number6) ? "border-red-500 bg-red-50/30" : "")" placeholder="6" />
                    </div>
                </div>

                <!-- Specialized Numbers -->
                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-blue-500 uppercase tracking-widest ml-1">@L["Complementary"]</label>
                        <input type="number" min="1" max="49" @bind="_editingDraw.Complementario" class="w-full bg-blue-50/50 border rounded-xl p-4 text-center text-sm font-black text-blue-700 outline-none focus:ring-2 focus:ring-blue-200 transition-all h-14 @(IsDuplicate(_editingDraw.Complementario) ? "border-red-500 bg-red-50/30" : "border-blue-100")" />
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-red-500 uppercase tracking-widest ml-1">@L["Reintegro"]</label>
                        <input type="number" min="0" max="9" @bind="_editingDraw.Reintegro" class="w-full bg-red-50/50 border border-red-100 rounded-xl p-4 text-center text-sm font-black text-red-700 outline-none focus:ring-2 focus:ring-red-200 transition-all h-14" />
                    </div>
                </div>

                <!-- Joker -->
                <div class="space-y-2">
                    <label class="text-[10px] font-black text-[var(--brand-text-secondary)] uppercase tracking-widest ml-1">@LG["Joker"] <span class="text-[8px] opacity-40 ml-1">(@LG["Optional"])</span></label>
                    <input type="text" inputmode="numeric" maxlength="7" pattern="[0-9]{7}" @bind="_editingDraw.Joker" placeholder="@L["JokerPlaceholder"]" class="w-full bg-white border border-[var(--brand-borders)] rounded-xl p-4 text-sm font-black text-[var(--brand-secondary)] outline-none focus:ring-2 focus:ring-[var(--brand-primary)]/20 transition-all tracking-[0.3em] h-14 text-center uppercase" />
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="p-4 bg-rose-50 border border-rose-100 rounded-2xl flex items-start gap-3 animate-in fade-in slide-in-from-top-2 duration-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-rose-500 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                        </svg>
                        <div>
                            <div class="text-[11px] font-bold text-rose-700">@_errorMessage</div>
                            @if (_hasConcurrencyConflict)
                            {
                                <button type="button" @onclick="ReloadWinningDrawAsync" class="mt-2 text-[10px] font-black uppercase tracking-widest text-rose-700 underline">
                                    @LG["ReloadCurrentData"]
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Modal Footer -->
            <div class="px-6 py-5 md:px-10 md:py-8 border-t border-[var(--brand-borders)] bg-white flex flex-col sm:flex-row justify-end gap-3">
                <button @onclick="CloseModal" class="px-8 py-3.5 rounded-xl text-xs font-bold text-[var(--brand-text-secondary)] hover:bg-[var(--brand-bg)] transition-all uppercase tracking-widest order-2 sm:order-1">
                    @LG["CancelButton"]
                </button>
                <button @onclick="SaveDraw" class="px-8 py-3.5 rounded-xl bg-[var(--brand-secondary)] text-white hover:bg-black font-bold shadow-xl shadow-[var(--brand-secondary)]/10 transition-all text-xs uppercase tracking-widest active:scale-95 order-1 sm:order-2 flex-1">
                    @L["SaveWinningDraw"]
                </button>
            </div>
        </div>
    </div>
}

@if (_showDeleteModal)
{
    <div class="fixed inset-0 bg-black/60 backdrop-blur-[2px] z-[100] flex items-center justify-center p-4 transition-all animate-in fade-in">
        <div class="bg-white w-full max-w-sm rounded-[var(--radius-modal)] shadow-2xl overflow-hidden p-8 space-y-6 animate-in zoom-in slide-in-from-bottom-4 duration-200">
            <div class="h-16 w-16 bg-red-50 rounded-2xl flex items-center justify-center mx-auto border border-red-100 mb-6">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
            </div>
            <div class="text-center space-y-2">
                <h3 class="text-xl font-black text-[var(--brand-secondary)]">@L["DeleteResultTitle"]</h3>
                <p class="text-sm text-[var(--brand-text-secondary)] font-medium">@string.Format(L["DeleteResultDescription"], _editingDraw.DrawDate.ToString("d"))</p>
                <div class="text-[10px] text-red-400 font-bold uppercase tracking-widest pt-2">@L["NoUndo"]</div>
            </div>
            <div class="flex flex-col gap-3 pt-4">
                <button @onclick="ConfirmDelete" class="w-full py-3.5 md:py-4 rounded-xl md:rounded-2xl bg-rose-600 hover:bg-rose-700 text-white text-xs md:text-sm font-bold uppercase tracking-widest shadow-xl shadow-rose-200 transition-all hover:scale-[1.02] active:scale-95">@LG["ConfirmDeleteButton"]</button>
                <button @onclick="CloseModal" class="w-full py-3.5 md:py-4 rounded-xl md:rounded-2xl bg-[var(--brand-bg)] text-[var(--brand-text-secondary)] text-xs md:text-sm font-bold uppercase tracking-widest hover:bg-[var(--brand-borders)] transition-all">@LG["CancelButton"]</button>
            </div>
        </div>
    </div>
}

@code {
    private List<WinningDrawDto>? _draws;
    private List<int>? _availableYears;
    private int _selectedYear;
    private bool _showModal = false;
    private bool _showDeleteModal = false;
    private bool _isEditing = false;
    private WinningDrawDto _editingDraw = CreateNewDto();
    private string? _errorMessage;
    private bool _hasConcurrencyConflict;

    protected override async Task OnInitializedAsync()
    {
        _availableYears = await WinningDrawService.GetAvailableYearsAsync();
        if (_availableYears.Any())
        {
            _selectedYear = _availableYears.First();
        }
        else
        {
            _selectedYear = DateTime.Today.Year;
        }

        await LoadDraws();
    }

    private async Task LoadDraws()
    {
        _draws = null; // Show loader
        StateHasChanged();
        _draws = await WinningDrawService.GetAllAsync(_selectedYear);
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var year))
        {
            _selectedYear = year;
            await LoadDraws();
        }
    }

    private void ShowCreateModal()
    {
        _isEditing = false;
        _editingDraw = CreateNewDto();
        _errorMessage = null;
        _hasConcurrencyConflict = false;
        _showModal = true;
    }

    private void ShowEditModal(WinningDrawDto draw)
    {
        _isEditing = true;
        _editingDraw = draw with { };
        _errorMessage = null;
        _hasConcurrencyConflict = false;
        _showModal = true;
    }

    private void ShowDeleteModal(WinningDrawDto draw)
    {
        _editingDraw = draw;
        _showDeleteModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
        _showDeleteModal = false;
        _errorMessage = null;
    }

    private async Task SaveDraw()
    {
        _errorMessage = null;

        Result result;
        try
        {
            if (_isEditing)
            {
                result = await WinningDrawService.UpdateAsync(_editingDraw);
            }
            else
            {
                var createResult = await WinningDrawService.CreateAsync(_editingDraw);
                result = createResult.IsSuccess ? Result.Success() : Result.Failure(createResult.Error!);
            }
        }
        catch (ConcurrencyConflictException exception)
        {
            ErrorReporter.Report(exception, "SaveWinningDraw");
            _hasConcurrencyConflict = true;
            _errorMessage = ApplicationError.FromException(exception).ToLocalizedMessage(LE);
            return;
        }
        catch (Exception exception) when (exception is IErrorException)
        {
            ErrorReporter.Report(exception, "SaveWinningDraw");
            _errorMessage = ApplicationError.FromException(exception).ToLocalizedMessage(LE);
            return;
        }
        catch (Exception exception)
        {
            var reference = ErrorReporter.Report(exception, "SaveWinningDraw");
            _errorMessage = string.Format(LE["MessageWithReference"], L["UnexpectedSaveError"], reference);
            return;
        }

        if (result.IsSuccess)
        {
            await LoadDraws();
            CloseModal();
        }
        else
        {
            _errorMessage = result.Error?.ToLocalizedMessage(LE);
        }
    }

    private async Task ReloadWinningDrawAsync()
    {
        var current = await WinningDrawService.GetByIdAsync(_editingDraw.Id);
        if (current == null)
        {
            CloseModal();
            await LoadDraws();
            return;
        }

        _editingDraw = current;
        _hasConcurrencyConflict = false;
        _errorMessage = null;
    }

    private async Task ConfirmDelete()
    {
        var result = await WinningDrawService.DeleteAsync(_editingDraw.Id);
        if (result.IsSuccess)
        {
            await LoadDraws();
            CloseModal();
        }
    }

    private bool IsDuplicate(int number)
    {
        if (number <= 0) return false;
        
        var numbers = new[] 
        { 
            _editingDraw.Number1, _editingDraw.Number2, _editingDraw.Number3, 
            _editingDraw.Number4, _editingDraw.Number5, _editingDraw.Number6, 
            _editingDraw.Complementario 
        };

        return numbers.Count(n => n == number) > 1;
    }

    private static WinningDrawDto CreateNewDto() => new(
        Guid.Empty,
        DateTime.Today,
        0, 0, 0, 0, 0, 0, 0, 0, null
    );
}
