@using Microsoft.Extensions.Localization
@using LaPrimitiva.Domain.Localization
@inject NavigationManager NavigationManager
@inject IStringLocalizer<GlobalResource> L
@implements IDisposable

<nav class="flex" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 md:space-x-3 text-xs font-medium uppercase tracking-wider">
        <li class="inline-flex items-center">
            <NavLink href="" class="inline-flex items-center text-[var(--brand-text-secondary)] hover:text-[var(--brand-primary)] transition-colors">
                <svg class="w-3 h-3 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
                </svg>
                @L["Home"]
            </NavLink>
        </li>
        @if (!string.IsNullOrEmpty(_currentPath) && _currentPath != "/")
        {
            @foreach (var segment in _segments)
            {
                <li>
                    <div class="flex items-center">
                        <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
                        <span class="ml-1 text-[var(--brand-secondary)] font-bold md:ml-2">@L[segment]</span>
                    </div>
                </li>
            }
        }
    </ol>
</nav>

@code {
    private string _currentPath = "";
    private string[] _segments = Array.Empty<string>();

    protected override void OnInitialized()
    {
        UpdatePath();
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdatePath();
        StateHasChanged();
    }

    private void UpdatePath()
    {
        _currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        _segments = _currentPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
