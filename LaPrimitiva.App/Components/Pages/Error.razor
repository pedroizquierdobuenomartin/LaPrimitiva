@page "/Error"
@using System.Diagnostics

@inject IStringLocalizer<ErrorResource> LE
@inject IStringLocalizer<GlobalResource> LG

<PageTitle>@LE["PageTitle"]</PageTitle>

<main class="mx-auto max-w-2xl p-8">
    <h1 class="text-3xl font-black text-rose-700">@LE["OperationFailedTitle"]</h1>
    <p class="mt-4 text-slate-700">
        @LE["GlobalErrorDescription"]
    </p>

@if (ShowRequestId)
{
    <p class="mt-4 text-sm text-slate-600">
        <strong>@LG["ReferenceLabel"]:</strong> <code>@RequestId</code>
    </p>
}
    <a class="mt-6 inline-flex rounded-xl bg-emerald-700 px-5 py-3 font-bold text-white" href="/">@LG["BackToHome"]</a>
</main>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
