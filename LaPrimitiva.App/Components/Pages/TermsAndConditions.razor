@page "/terminos"
@using LaPrimitiva.Domain.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<TermsAndConditionsResource> L

<PageTitle>@L["TermsTitle"] - La Primitiva Audit</PageTitle>

<div class="max-w-4xl mx-auto space-y-16 py-12 px-4 animate-in fade-in slide-in-from-bottom-4 duration-700">
    <!-- Header Section -->
    <div class="text-center space-y-4">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-emerald-50 text-[var(--brand-primary)] rounded-full text-[10px] font-black uppercase tracking-widest mb-4">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M12 22C12 22 20 18 20 12V5L12 2L4 5V12C4 18 12 22 12 22Z" />
            </svg>
            Garantía Legal
        </div>
        <h1 class="text-4xl md:text-5xl font-black text-[var(--brand-secondary)] tracking-tight">
            @L["TermsTitle"]
        </h1>
        <p class="text-lg md:text-xl text-[var(--brand-text-secondary)] font-medium max-w-2xl mx-auto leading-relaxed">
            @L["TermsSubtitle"]
        </p>
    </div>

    <!-- Main Content Card -->
    <div class="bg-white rounded-[32px] p-8 md:p-12 border border-[var(--brand-borders)]/10 shadow-sm relative overflow-hidden group">
        <div class="absolute top-0 right-0 p-8 opacity-5 group-hover:scale-110 transition-transform duration-700">
            <svg class="h-48 w-48 text-[var(--brand-primary)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                <path d="M9 12L11 14L15 10M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
        
        <div class="relative z-10 space-y-12">
            <!-- Intro -->
            <div class="space-y-4">
                <h2 class="text-2xl font-bold text-[var(--brand-secondary)] flex items-center gap-3">
                    <span class="h-8 w-1 bg-[var(--brand-accent)] rounded-full"></span>
                    @L["IntroTitle"]
                </h2>
                <p class="text-[var(--brand-text-secondary)] leading-relaxed text-lg">
                    @L["IntroDesc"]
                </p>
            </div>

            <!-- Sections Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="space-y-4 p-6 rounded-2xl bg-gray-50/50 border border-gray-100/50 hover:bg-white hover:shadow-md transition-all">
                    <h3 class="font-bold text-[var(--brand-secondary)] flex items-center gap-3">
                        <div class="h-8 w-8 rounded-lg bg-emerald-500/10 text-[var(--brand-primary)] flex items-center justify-center text-xs">01</div>
                        @L["Section1Title"]
                    </h3>
                    <p class="text-sm text-[var(--brand-text-secondary)] leading-relaxed">
                        @L["Section1Desc"]
                    </p>
                </div>

                <div class="space-y-4 p-6 rounded-2xl bg-gray-50/50 border border-gray-100/50 hover:bg-white hover:shadow-md transition-all">
                    <h3 class="font-bold text-[var(--brand-secondary)] flex items-center gap-3">
                        <div class="h-8 w-8 rounded-lg bg-emerald-500/10 text-[var(--brand-primary)] flex items-center justify-center text-xs">02</div>
                        @L["Section2Title"]
                    </h3>
                    <p class="text-sm text-[var(--brand-text-secondary)] leading-relaxed">
                        @L["Section2Desc"]
                    </p>
                </div>

                <div class="space-y-4 p-6 rounded-2xl bg-gray-50/50 border border-gray-100/50 hover:bg-white hover:shadow-md transition-all">
                    <h3 class="font-bold text-[var(--brand-secondary)] flex items-center gap-3">
                        <div class="h-8 w-8 rounded-lg bg-emerald-500/10 text-[var(--brand-primary)] flex items-center justify-center text-xs">03</div>
                        @L["Section3Title"]
                    </h3>
                    <p class="text-sm text-[var(--brand-text-secondary)] leading-relaxed">
                        @L["Section3Desc"]
                    </p>
                </div>

                <div class="space-y-4 p-6 rounded-2xl bg-gray-50/50 border border-gray-100/50 hover:bg-white hover:shadow-md transition-all">
                    <h3 class="font-bold text-[var(--brand-secondary)] flex items-center gap-3">
                        <div class="h-8 w-8 rounded-lg bg-emerald-500/10 text-[var(--brand-primary)] flex items-center justify-center text-xs">04</div>
                        @L["Section4Title"]
                    </h3>
                    <p class="text-sm text-[var(--brand-text-secondary)] leading-relaxed">
                        @L["Section4Desc"]
                    </p>
                </div>
            </div>

            <!-- Legislation Banner -->
            <div class="p-6 bg-emerald-50 rounded-2xl border border-[var(--brand-primary)]/10 flex flex-col md:flex-row items-center gap-6">
                <div class="h-12 w-12 rounded-xl bg-white shadow-sm flex items-center justify-center flex-shrink-0">
                    <svg class="h-6 w-6 text-[var(--brand-primary)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <p class="text-[11px] font-bold text-[var(--brand-secondary)] uppercase tracking-wider text-center md:text-left leading-relaxed">
                    @L["LegislationNote"]
                </p>
            </div>
        </div>
    </div>

    <!-- Contact CTA Section -->
    <div class="bg-gradient-to-br from-[var(--brand-secondary)] to-[var(--brand-primary)] rounded-[32px] p-8 md:p-12 text-center text-white space-y-8 shadow-2xl relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('/images/pattern.png')] opacity-5 pointer-events-none"></div>
        <div class="absolute -top-10 -right-10 h-40 w-40 bg-[var(--brand-accent)]/20 rounded-full blur-3xl"></div>
        
        <div class="relative z-10 space-y-3">
            <h2 class="text-2xl font-black italic tracking-tight">@L["ContactTitle"]</h2>
            <p class="text-white/70 font-medium max-w-lg mx-auto text-sm">
                @L["ContactDesc"]
            </p>
        </div>
        
        <div class="relative z-10">
            <button class="bg-white text-[var(--brand-secondary)] hover:bg-[var(--brand-accent)] hover:text-white px-8 py-3 rounded-xl font-black uppercase tracking-widest text-[10px] transition-all shadow-xl hover:-translate-y-1 active:scale-95">
                @L["ContactButton"]
            </button>
        </div>
    </div>
</div>

@code {
}
