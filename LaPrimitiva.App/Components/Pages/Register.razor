                                <div class="space-y-4 md:space-y-6">
                                    <div class="flex items-center gap-3 px-1">
                                        <div class="h-7 w-7 md:h-8 md:w-8 rounded-lg bg-[var(--brand-secondary)] text-white flex items-center justify-center">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                                            </svg>
                                        </div>
                                        <label class="text-[10px] md:text-xs font-bold text-[var(--brand-secondary)] uppercase tracking-widest">Modelo de Plan</label>
                                    </div>
                                    <div class="relative group">
                                        <select @bind="selectedPlanId" class="w-full bg-[var(--brand-bg)] border-2 border-[var(--brand-bg)] rounded-xl md:rounded-[1.5rem] p-4 md:p-5 text-sm md:text-base font-bold text-[var(--brand-secondary)] focus:ring-4 focus:ring-[var(--brand-primary)]/10 focus:border-[var(--brand-primary)]/20 transition-all appearance-none cursor-pointer">
                                            @if (allPlans != null)
                                            {
                                                @foreach (var plan in allPlans)
                                                {
                                                    <option value="@plan.Id">@plan.Name (@plan.BetsPerDraw Apuestas)</option>
                                                }
                                            }
                                        </select>
                                        <div class="absolute right-5 top-1/2 -translate-y-1/2 pointer-events-none text-[var(--brand-text-secondary)]">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                                            </svg>
                                        </div>
                                    </div>
                                </div>

                                <!-- Custom Draw Addition -->
                                <div class="space-y-4 md:space-y-6">
                                    <div class="flex items-center gap-3 px-1">
                                        <div class="h-7 w-7 md:h-8 md:w-8 rounded-lg bg-[var(--brand-primary)] text-white flex items-center justify-center shadow-lg shadow-[var(--brand-primary)]/10">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                                            </svg>
                                        </div>
                                        <label class="text-[10px] md:text-xs font-bold text-[var(--brand-secondary)] uppercase tracking-widest">Añadir Sorteos</label>
                                    </div>
                                    <div class="flex flex-wrap gap-2 md:gap-3">
                                        <button @onclick='() => AddDrawTemplate(DayOfWeek.Monday)' class="flex-1 bg-white border-2 border-[var(--brand-bg)] text-[var(--brand-text-secondary)] px-3 md:px-6 py-3 md:py-4 rounded-xl md:rounded-2xl text-[10px] md:text-[11px] font-bold uppercase tracking-wider hover:border-[var(--brand-primary)] hover:text-[var(--brand-primary)] hover:bg-[var(--brand-primary)]/5 transition-all active:scale-95">Lunes</button>
                                        <button @onclick='() => AddDrawTemplate(DayOfWeek.Thursday)' class="flex-1 bg-white border-2 border-[var(--brand-bg)] text-[var(--brand-text-secondary)] px-3 md:px-6 py-3 md:py-4 rounded-xl md:rounded-2xl text-[10px] md:text-[11px] font-bold uppercase tracking-wider hover:border-[var(--brand-primary)] hover:text-[var(--brand-primary)] hover:bg-[var(--brand-primary)]/5 transition-all active:scale-95">Jueves</button>
                                        <button @onclick='() => AddDrawTemplate(DayOfWeek.Saturday)' class="flex-1 bg-white border-2 border-[var(--brand-bg)] text-[var(--brand-text-secondary)] px-3 md:px-6 py-3 md:py-4 rounded-xl md:rounded-2xl text-[10px] md:text-[11px] font-bold uppercase tracking-wider hover:border-[var(--brand-primary)] hover:text-[var(--brand-primary)] hover:bg-[var(--brand-primary)]/5 transition-all active:scale-95">Sábado</button>
                                    </div>
                                    
                                    @if (tempModalDraws.Any())
                                    {
                                        <div class="mt-4 md:mt-8 grid grid-cols-1 gap-2 md:gap-3">
                                            @foreach (var d in tempModalDraws)
                                            {
