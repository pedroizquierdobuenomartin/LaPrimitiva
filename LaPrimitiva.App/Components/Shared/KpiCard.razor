<div class="kpi-card p-6 flex flex-col gap-2 relative overflow-hidden group @GetCardBgStyles() border-none shadow-sm h-full">
    <!-- Background Icon Wrapper -->
    <div class="absolute -right-4 -bottom-4 w-32 h-32 opacity-[0.08] transition-all duration-500 group-hover:scale-110 group-hover:-rotate-12 pointer-events-none @GetIconTextStyles()">
        @Icon
    </div>

    <div class="relative z-10 flex flex-col gap-1">
        <span class="text-xs font-bold @GetTitleTextStyles() uppercase tracking-wider opacity-80">@Title</span>
        <span class="text-3xl font-bold @GetValueTextStyles()">@Value</span>
    </div>
    
    @if (!string.IsNullOrEmpty(SubValue))
    {
        <div class="relative z-10 mt-auto pt-2 text-sm font-semibold @GetSubValueTextStyles() flex items-center gap-2">
            <div class="w-1.5 h-1.5 rounded-full @GetIndicatorStyles() shadow-sm"></div>
            @SubValue
        </div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string? SubValue { get; set; }
    [Parameter] public string Color { get; set; } = "blue";
    [Parameter] public RenderFragment? Icon { get; set; }

    private string GetCardBgStyles() => Color.ToLower() switch
    {
        "red" => "bg-rose-50/80",
        "emerald" => "bg-emerald-50/80",
        "orange" => "bg-amber-50/80",
        "violet" => "bg-purple-50/80",
        _ => "bg-slate-50/80"
    };

    private string GetTitleTextStyles() => Color.ToLower() switch
    {
        "red" => "text-rose-900",
        "emerald" => "text-emerald-900",
        "orange" => "text-amber-900",
        "violet" => "text-purple-900",
        _ => "text-slate-900"
    };

    private string GetValueTextStyles() => Color.ToLower() switch
    {
        "red" => "text-rose-700",
        "emerald" => "text-emerald-700",
        "orange" => "text-amber-700",
        "violet" => "text-purple-700",
        _ => "text-slate-700"
    };

    private string GetSubValueTextStyles() => Color.ToLower() switch
    {
        "red" => "text-rose-600/80",
        "emerald" => "text-emerald-600/80",
        "orange" => "text-amber-600/80",
        "violet" => "text-purple-600/80",
        _ => "text-slate-600/80"
    };

    private string GetIconTextStyles() => Color.ToLower() switch
    {
        "red" => "text-rose-500",
        "emerald" => "text-emerald-500",
        "orange" => "text-amber-500",
        "violet" => "text-purple-500",
        _ => "text-slate-500"
    };

    private string GetIndicatorStyles() => Color.ToLower() switch
    {
        "red" => "bg-rose-500",
        "emerald" => "bg-emerald-500",
        "orange" => "bg-amber-500",
        "violet" => "bg-purple-500",
        _ => "bg-slate-500"
    };
}
