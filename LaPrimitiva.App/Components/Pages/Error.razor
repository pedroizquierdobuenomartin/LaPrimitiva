@page "/Error"
@using System.Diagnostics

<PageTitle>Error - La Primitiva Audit</PageTitle>

<main class="mx-auto max-w-2xl p-8">
    <h1 class="text-3xl font-black text-rose-700">No hemos podido completar la operación</h1>
    <p class="mt-4 text-slate-700">
        La aplicación ha registrado el detalle técnico de forma segura. Puedes volver a la página anterior e intentarlo de nuevo.
    </p>

@if (ShowRequestId)
{
    <p class="mt-4 text-sm text-slate-600">
        <strong>Referencia:</strong> <code>@RequestId</code>
    </p>
}
    <a class="mt-6 inline-flex rounded-xl bg-emerald-700 px-5 py-3 font-bold text-white" href="/">Volver al inicio</a>
</main>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
