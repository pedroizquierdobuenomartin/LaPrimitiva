                                                    <div class="flex items-center gap-3 md:gap-4">
                                                        <div class="h-8 w-8 md:h-10 md:w-10 rounded-lg md:rounded-xl bg-white flex items-center justify-center text-[var(--brand-primary)] font-bold text-[10px] md:text-xs shadow-sm">
