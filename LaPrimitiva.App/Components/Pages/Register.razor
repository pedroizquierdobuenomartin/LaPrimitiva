                                                <label class="text-[8px] md:text-[9px] font-bold text-[var(--brand-primary)]/50 uppercase ml-1">Fija (€)</label>
                                                <input type="number" step="0.01" @bind="draw.FixedPrize" @bind:after="() => RecalculateDraw(draw)" disabled="@(!draw.Played || draw.CosteFija == 0)" class="w-full bg-[var(--brand-primary)]/5 border-none rounded-xl p-2 md:p-3 text-xs md:text-sm font-bold text-[var(--brand-primary)] focus:ring-2 focus:ring-[var(--brand-primary)]/20 disabled:opacity-50 disabled:cursor-not-allowed transition-all" />
                                            </div>
                                            <div class="group">
                                                <label class="text-[8px] md:text-[9px] font-bold text-[var(--brand-primary)]/50 uppercase ml-1">Auto (€)</label>
                                                <input type="number" step="0.01" @bind="draw.AutoPrize" @bind:after="() => RecalculateDraw(draw)" disabled="@(!draw.Played || draw.CosteAuto == 0)" class="w-full bg-[var(--brand-primary)]/5 border-none rounded-xl p-2 md:p-3 text-xs md:text-sm font-bold text-[var(--brand-primary)] focus:ring-2 focus:ring-[var(--brand-primary)]/20 disabled:opacity-50 disabled:cursor-not-allowed transition-all" />
