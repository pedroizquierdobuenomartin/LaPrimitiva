@page "/"
@using LaPrimitiva.Application.Services
@using LaPrimitiva.Application.DTOs
@using LaPrimitiva.Domain.Repositories
@using LaPrimitiva.Domain.Localization
@using LaPrimitiva.App.Components.Shared
@using Microsoft.Extensions.Localization
@inject IDrawRepository DrawRepository
@inject SummaryService SummaryService
@inject GlobalState GlobalState
@inject IStringLocalizer<DashboardResource> L
@inject IStringLocalizer<GlobalResource> LG
@implements IDisposable

<PageTitle>@L["Dashboard"] - La Primitiva Audit</PageTitle>

<div class="space-y-10 animate-in fade-in duration-700">
    <div class="flex flex-col gap-2">
        <h2 class="text-4xl font-bold text-[var(--brand-secondary)] tracking-tight">@L["Dashboard"]</h2>
        <p class="text-[var(--brand-text-secondary)] font-medium text-lg">@(GlobalState.IsHistoricalView ? L["HistoricalSummary"] : $"{L["SummaryAndKPIs"]} {GlobalState.SelectedYear}.")</p>
    </div>

    @if (summary == null)
    {
        <div class="flex flex-col items-center justify-center p-32 bg-white rounded-[var(--radius-card)] border border-[var(--brand-borders)] shadow-sm">
            <div class="animate-spin rounded-full h-16 w-16 border-b-4 border-[var(--brand-primary)] mb-6"></div>
            <p class="text-[var(--brand-text-secondary)] font-bold text-lg">Cargando datos...</p>
        </div>
    }
    else
    {
        <!-- KPI Row -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            <div class="transform transition-all duration-300">
                <KpiCard Title="@L["TotalSpent"]" Value="@($"{summary.TotalSpent:N2}€")" SubValue="@($"{summary.PlayedDraws} {L["PlayedDraws"]}")" Color="red">
                    <Icon>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4Z"/></svg>
                    </Icon>
                </KpiCard>
            </div>
            <div class="transform transition-all duration-300">
                <KpiCard Title="@L["TotalWon"]" Value="@($"{summary.TotalWon:N2}€")" SubValue="@($"{summary.WinningDraws} {L["WithPrize"]}")" Color="emerald">
                    <Icon>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
                    </Icon>
                </KpiCard>
            </div>
            <div class="transform transition-all duration-300">
                <KpiCard Title="@L["Net"]" Value="@($"{summary.NetResult:N2}€")" SubValue="@($"{summary.ROI:N1}% ROI")" Color="orange">
                    <Icon>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
                    </Icon>
                </KpiCard>
            </div>
            <div class="transform transition-all duration-300">
                <KpiCard Title="@L["Effectiveness"]" Value="@($"{summary.WinningPercentage:N1}%")" SubValue="@L["WinningDrawsDesc"]" Color="violet">
                    <Icon>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                    </Icon>
                </KpiCard>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
            <!-- Chart Section -->
            <div class="lg:col-span-2 bg-white p-10 rounded-[var(--radius-card)] border border-[var(--brand-borders)] shadow-sm flex flex-col min-h-[500px]">
                <div class="flex justify-between items-center mb-10">
                    <h3 class="text-xl font-bold text-[var(--brand-secondary)]">@L["NetEvolution"]</h3>
                </div>
                <div class="flex-1 min-h-0">
                    <ChartComponent Id="netEvolutionChart" Config="@chartConfig" @ref="chartComponent" />
                </div>
            </div>

            <!-- Breakdown -->
            <div class="bg-white p-10 rounded-[var(--radius-card)] border border-[var(--brand-borders)] shadow-sm h-full flex flex-col">
                <h3 class="text-xl font-bold text-[var(--brand-secondary)] mb-10 border-b border-[var(--brand-bg)] pb-6">@L["BreakdownByType"]</h3>
                <div class="space-y-10 flex-1">
                    <div class="group px-1">
                        <div class="flex justify-between text-sm mb-4">
                            <span class="font-bold text-[var(--brand-text-primary)] group-hover:text-[var(--brand-primary)] transition-colors">@L["FixedCombination"]</span>
                            <span class="@(summary.FixedWon - summary.FixedSpent >= 0 ? "text-[var(--brand-positive)]" : "text-[var(--brand-negativo)]") font-bold text-lg">
                                @((summary.FixedWon - summary.FixedSpent).ToString("N2"))€
                            </span>
                        </div>
                        <div class="w-full bg-[var(--brand-bg)] rounded-full h-3 flex overflow-hidden shadow-inner">
                            @{
                                var fixedVol = summary.FixedSpent + summary.FixedWon;
                            }
                            <div class="bg-rose-400 h-full transition-all duration-1000 ease-out" 
                                 style="width: @(GetBarWidthPercent(summary.FixedSpent, fixedVol).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            <div class="bg-emerald-400 h-full transition-all duration-1000 ease-out" 
                                 style="width: @(GetBarWidthPercent(summary.FixedWon, fixedVol).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                        </div>
                        <div class="flex justify-between text-xs font-bold text-[var(--brand-text-secondary)] mt-3">
                            <span>@L["Expense"]: @summary.FixedSpent.ToString("N2")€</span>
                            <span>@L["Prize"]: @summary.FixedWon.ToString("N2")€</span>
                        </div>
                    </div>

                    <div class="group px-1">
                        <div class="flex justify-between text-sm mb-4">
                            <span class="font-bold text-[var(--brand-text-primary)] group-hover:text-[var(--brand-primary)] transition-colors">@L["AutoCombination"]</span>
                            <span class="@(summary.AutoWon - summary.AutoSpent >= 0 ? "text-[var(--brand-positive)]" : "text-[var(--brand-negativo)]") font-bold text-lg">
                                @((summary.AutoWon - summary.AutoSpent).ToString("N2"))€
                            </span>
                        </div>
                        <div class="w-full bg-[var(--brand-bg)] rounded-full h-3 flex overflow-hidden shadow-inner">
                            @{
                                var autoVol = summary.AutoSpent + summary.AutoWon;
                            }
                            <div class="bg-rose-400 h-full transition-all duration-1000 ease-out" 
                                 style="width: @(GetBarWidthPercent(summary.AutoSpent, autoVol).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            <div class="bg-emerald-400 h-full transition-all duration-1000 ease-out" 
                                 style="width: @(GetBarWidthPercent(summary.AutoWon, autoVol).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                        </div>
                        <div class="flex justify-between text-xs font-bold text-[var(--brand-text-secondary)] mt-3">
                            <span>@L["Expense"]: @summary.AutoSpent.ToString("N2")€</span>
                            <span>@L["Prize"]: @summary.AutoWon.ToString("N2")€</span>
                        </div>
                    </div>

                    <div class="group px-1">
                        <div class="flex justify-between text-sm mb-4">
                            <span class="font-bold text-[var(--brand-text-primary)] group-hover:text-[var(--brand-primary)] transition-colors">Joker (Total)</span>
                            <span class="@((summary.JokerFixedWon + summary.JokerAutoWon) - (summary.JokerFixedSpent + summary.JokerAutoSpent) >= 0 ? "text-[var(--brand-positive)]" : "text-[var(--brand-negativo)]") font-bold text-lg">
                                @(((summary.JokerFixedWon + summary.JokerAutoWon) - (summary.JokerFixedSpent + summary.JokerAutoSpent)).ToString("N2"))€
                            </span>
                        </div>
                        <div class="w-full bg-[var(--brand-bg)] rounded-full h-3 flex overflow-hidden shadow-inner">
                            @{
                                var js = summary.JokerFixedSpent + summary.JokerAutoSpent;
                                var jw = summary.JokerFixedWon + summary.JokerAutoWon;
                                var jokerVol = js + jw;
                            }
                            <div class="bg-rose-400 h-full transition-all duration-1000 ease-out" 
                                 style="width: @(GetBarWidthPercent(js, jokerVol).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            <div class="bg-emerald-400 h-full transition-all duration-1000 ease-out" 
                                 style="width: @(GetBarWidthPercent(jw, jokerVol).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                        </div>
                        <div class="flex justify-between text-xs font-bold text-[var(--brand-text-secondary)] mt-3">
                            <span>@L["Expense"]: @((summary.JokerFixedSpent + summary.JokerAutoSpent).ToString("N2"))€</span>
                            <span>@L["Prize"]: @((summary.JokerFixedWon + summary.JokerAutoWon).ToString("N2"))€</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private SummaryDto? summary;
    private ChartComponent? chartComponent;
    private object chartConfig = new { };

    protected override async Task OnInitializedAsync()
    {
        GlobalState.OnChange += HandleStateChange;
        await LoadData();
    }

    private async void HandleStateChange()
    {
        await InvokeAsync(async () => 
        {
            try 
            {
                await LoadData();
                if (chartComponent != null)
                {
                    await chartComponent.UpdateChartAsync(chartConfig);
                }
            }
            finally 
            {
                StateHasChanged();
            }
        });
    }

    private async Task LoadData()
    {
        IEnumerable<LaPrimitiva.Domain.Entities.DrawRecord> draws;
        
        if (GlobalState.IsHistoricalView)
        {
            draws = await DrawRepository.GetListAsync(_ => true);
        }
        else
        {
            var year = GlobalState.SelectedYear;
            draws = await DrawRepository.GetListAsync(d => d.DrawDate.Year == year);
        }
            
        summary = SummaryService.GetSummary(draws);
        PrepareChartConfig(draws);
    }

    private void PrepareChartConfig(IEnumerable<LaPrimitiva.Domain.Entities.DrawRecord> draws)
    {
        var monthlySummaries = SummaryService.GetMonthlySummaries(draws);
        
        // Calculate cumulative net
        decimal cumulativeNet = 0;
        var labels = new List<string>();
        var dataPoints = new List<decimal>();

        foreach (var m in monthlySummaries)
        {
            cumulativeNet += m.Net;
            labels.Add(GlobalState.IsHistoricalView ? $"{m.Month}/{m.Year}" : m.MonthName);
            dataPoints.Add(cumulativeNet);
        }

        chartConfig = new
        {
            type = "line",
            data = new
            {
                labels = labels,
                datasets = new[]
                {
                    new
                    {
                        label = L["NetEvolution"].Value,
                        data = dataPoints,
                        borderColor = "#007041",
                        backgroundColor = "rgba(0, 112, 65, 0.1)",
                        fill = true,
                        tension = 0.4,
                        pointRadius = 4,
                        pointHoverRadius = 8,
                        borderWidth = 4,
                        pointBackgroundColor = "#ffffff",
                        pointBorderColor = "#007041",
                        pointBorderWidth = 2
                    }
                }
            },
            options = new
            {
                responsive = true,
                maintainAspectRatio = false,
                animation = new { duration = 2000, easing = "easeOutQuart" },
                plugins = new
                {
                    legend = new { display = false },
                    tooltip = new { 
                        mode = "index", 
                        intersect = false,
                        padding = 16,
                        backgroundColor = "rgba(0, 77, 45, 0.95)",
                        titleFont = new { size = 14, weight = "bold", family = "Poppins" },
                        bodyFont = new { size = 14, family = "Inter" },
                        displayColors = false,
                        cornerRadius = 12
                    }
                },
                scales = new
                {
                    y = new
                    {
                        beginAtZero = false,
                        grid = new { color = "rgba(233, 236, 239, 1)" },
                        ticks = new { font = new { family = "Inter", size = 12 } }
                    },
                    x = new
                    {
                        grid = new { display = false },
                        ticks = new { font = new { family = "Inter", size = 12 } }
                    }
                }
            }
        };
    }

    private double GetBarWidthPercent(decimal val, decimal total)
    {
        if (total == 0) return 0;
        var percent = (double)(val / total * 100);
        return Math.Min(100, Math.Abs(percent));
    }

    public void Dispose()
    {
        GlobalState.OnChange -= HandleStateChange;
    }
}
