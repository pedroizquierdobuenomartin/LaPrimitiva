@using LaPrimitiva.Domain.Repositories
@using LaPrimitiva.Domain.Localization
@using LaPrimitiva.Domain.Entities
@using LaPrimitiva.Application.Interfaces
@using LaPrimitiva.Application.Services
@using Microsoft.Extensions.Localization
@inject IPlanRepository PlanRepository
@inject IDrawRepository DrawRepository
@inject GlobalState GlobalState
@inject IDrawService DrawService
@inject IStringLocalizer<PrimitivaResource> L
@implements IDisposable
@page "/registro"

<PageTitle>Registro - La Primitiva Audit</PageTitle>

<div class="space-y-10 animate-in fade-in duration-700">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6">
        <div>
            <h2 class="text-3xl md:text-4xl font-bold text-[var(--brand-secondary)] tracking-tight">@L["Registration"]</h2>
            <p class="text-[var(--brand-text-secondary)] mt-1 md:mt-2 font-medium text-sm md:base">@L["DrawRecordsForYear"] @GlobalState.SelectedYear.</p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 md:gap-4 items-stretch sm:items-center w-full md:w-auto">
            <button @onclick="ShowRegisterModal" class="bg-[var(--brand-accent)] hover:opacity-90 text-white px-6 md:px-8 py-3 md:py-3.5 rounded-2xl text-sm font-bold shadow-xl shadow-[var(--brand-accent)]/20 transition-all flex items-center justify-center gap-2 transform hover:scale-105 active:scale-95">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                </svg>
                @L["AddNewDraw"]
            </button>
            <div class="bg-white px-5 py-3 rounded-2xl border border-[var(--brand-borders)] shadow-sm flex items-center justify-between sm:justify-start gap-3">
                <div class="flex items-center gap-3">
                    <div class="h-2.5 w-2.5 rounded-full @(allPlans?.Any() == true ? "bg-[var(--brand-positive)] animate-pulse" : "bg-rose-500")"></div>
                    <span class="text-[var(--brand-text-secondary)] text-[10px] font-bold uppercase tracking-widest">@L["Plan"]:</span>
                </div>
                @if (allPlans?.Any() == true)
                {
                    <select @bind="SelectedPlanId" class="text-[var(--brand-secondary)] text-sm font-bold bg-transparent border-none p-0 focus:ring-0 cursor-pointer">
                        @foreach (var plan in allPlans)
                        {
                            <option value="@plan.Id">@plan.Name</option>
                        }
                    </select>
                }
                else
                {
                    <span class="text-rose-600 text-sm font-bold">No existe plan</span>
                }
            </div>
        </div>
    </div>

    @if (drawsWithCumulative == null)
    {
        <div class="flex justify-center p-32">
            <div class="relative">
                <div class="h-24 w-24 rounded-full border-4 border-[var(--brand-bg)] border-t-[var(--brand-primary)] animate-spin"></div>
                <div class="absolute inset-0 flex items-center justify-center text-[var(--brand-primary)] font-bold text-xs uppercase tracking-tighter">Cargando</div>
            </div>
        </div>
    }
    else
    {
        <div class="space-y-6">
            <!-- Mobile View: Cards -->
            <div class="grid grid-cols-1 gap-4 lg:hidden">
                @foreach (var item in drawsWithCumulative)
                {
                    var draw = item.Draw;
                    <div class="bg-white rounded-[1.5rem] border border-[var(--brand-borders)] shadow-sm overflow-hidden p-5 flex flex-col gap-4">
                        <div class="flex justify-between items-start">
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="bg-[var(--brand-secondary)] text-white text-[10px] font-bold px-2 py-0.5 rounded-md">W @draw.WeekNumber</span>
                                    <span class="text-xs font-bold text-[var(--brand-secondary)]">@draw.DrawDate.ToString("dd/MM/yy")</span>
                                </div>
                                <div class="text-[10px] text-[var(--brand-text-secondary)] italic mt-1 font-medium uppercase tracking-tight">@draw.DrawType</div>
                            </div>
                            <div class="h-8 w-8 rounded-lg @(draw.Played ? "bg-[var(--brand-primary)]" : "bg-slate-100") flex items-center justify-center text-white">
                                @(draw.Played ? "✓" : "")
                            </div>
                        </div>

                        <div class="grid grid-cols-3 gap-2">
                            <div class="bg-purple-50 p-2.5 rounded-xl text-center">
                                <div class="text-[8px] font-bold text-purple-400 uppercase">Coste</div>
                                <div class="text-xs font-bold text-purple-700 mt-0.5">@draw.TotalCoste.ToString("N2")€</div>
                            </div>
                            <div class="bg-emerald-50 p-2.5 rounded-xl text-center">
                                <div class="text-[8px] font-bold text-emerald-400 uppercase">Premio</div>
                                <div class="text-xs font-bold text-emerald-700 mt-0.5">@draw.TotalPremios.ToString("N2")€</div>
                            </div>
                            <div class="p-2.5 rounded-xl text-center @(draw.Neto >= 0 ? "bg-emerald-50" : "bg-rose-50")">
                                <div class="text-[8px] font-bold @(draw.Neto >= 0 ? "text-emerald-600" : "text-rose-600") uppercase">Neto</div>
                                <div class="text-xs font-bold @(draw.Neto >= 0 ? "text-emerald-700" : "text-rose-700") mt-0.5">@draw.Neto.ToString("N2")€</div>
                            </div>
                        </div>

                        <div class="flex justify-between items-end py-1">
                            <div class="px-3 py-2 rounded-xl @(draw.Acumulado < 0 ? "bg-rose-50" : draw.Acumulado == 0 ? "bg-slate-50" : "bg-emerald-50")">
                                <div class="text-[8px] font-bold @(draw.Acumulado < 0 ? "text-rose-600" : draw.Acumulado == 0 ? "text-slate-600" : "text-emerald-600") uppercase tracking-wider">Acumulado</div>
                                <div class="text-sm font-black @(draw.Acumulado < 0 ? "text-rose-700" : draw.Acumulado == 0 ? "text-slate-700" : "text-emerald-700")">
                                    @draw.Acumulado.ToString("N2")€
                                </div>
                            </div>
                            <div class="flex gap-2 mb-0.5">
                                <button @onclick="() => EditDraw(draw)" class="h-10 w-10 rounded-xl bg-[var(--brand-bg)] text-[var(--brand-secondary)] flex items-center justify-center transition-all active:scale-95 border border-[var(--brand-borders)]">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                    </svg>
                                </button>
                                <button @onclick="() => ConfirmDeleteWeek(draw.WeekNumber, draw.DrawDate.Year, draw.PlanId)" class="h-10 w-10 rounded-xl bg-rose-50 text-rose-500 flex items-center justify-center transition-all active:scale-95 border border-rose-100">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Desktop View: Table -->
            <div class="hidden lg:block bg-white rounded-[var(--radius-card)] border border-[var(--brand-borders)] shadow-sm overflow-hidden min-h-[400px]">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-separate border-spacing-0 min-w-max">
                        <thead class="bg-[var(--brand-bg)] border-b border-[var(--brand-borders)]">
                            <tr>
                                <th class="sticky left-0 z-20 bg-[var(--brand-bg)]/90 backdrop-blur-sm px-6 py-5 text-[10px] font-bold text-[var(--brand-text-secondary)] uppercase tracking-widest border-r border-[var(--brand-borders)]">@L["Week"]</th>
                                <th class="sticky left-[82px] z-20 bg-[var(--brand-bg)]/90 backdrop-blur-sm px-6 py-5 text-[10px] font-bold text-[var(--brand-text-secondary)] uppercase tracking-widest border-r border-[var(--brand-borders)]">@L["DrawType"]</th>
                                <th class="sticky left-[152px] z-20 bg-[var(--brand-bg)]/90 backdrop-blur-sm px-6 py-5 text-[10px] font-bold text-[var(--brand-text-secondary)] uppercase tracking-widest border-r border-[var(--brand-borders)]">@L["Date"]</th>
                                <th class="px-4 py-5 text-[10px] font-bold text-[var(--brand-text-secondary)] uppercase tracking-widest text-center">J.</th>
                                
                                <th class="px-4 py-5 text-[10px] font-bold text-[var(--brand-text-secondary)] uppercase tracking-widest text-right bg-white/50">C. Fija</th>
                                <th class="px-4 py-5 text-[10px] font-bold text-[var(--brand-text-secondary)] uppercase tracking-widest text-right bg-white/50">C. Auto</th>
                                <th class="px-6 py-5 text-[10px] font-bold text-[var(--brand-secondary)] uppercase tracking-widest text-right bg-white">Total C.</th>
                                
                                <th class="px-4 py-5 text-[10px] font-bold text-[var(--brand-primary)] uppercase tracking-widest text-right bg-[var(--brand-primary)]/5">P. Fija</th>
                                <th class="px-4 py-5 text-[10px] font-bold text-[var(--brand-primary)] uppercase tracking-widest text-right bg-[var(--brand-primary)]/5">P. Auto</th>
                                <th class="px-6 py-5 text-[10px] font-bold text-[var(--brand-secondary)] uppercase tracking-widest text-right bg-[var(--brand-primary)]/10">Total P.</th>
                                
                                <th class="px-6 py-5 text-[10px] font-bold text-[var(--brand-secondary)] uppercase tracking-widest text-right border-l border-[var(--brand-borders)]">@L["Net"]</th>
                                <th class="px-6 py-5 text-[10px] font-bold text-white uppercase tracking-widest text-right bg-[var(--brand-secondary)]">@L["Acumulado"]</th>
                                <th class="px-6 py-5 text-[10px] font-bold text-[var(--brand-text-secondary)] uppercase tracking-widest">@L["Notes"]</th>
                                <th class="px-6 py-5"></th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[var(--brand-bg)] font-medium text-xs">
                            @foreach (var item in drawsWithCumulative)
                            {
                                var draw = item.Draw;
                                <tr class="hover:bg-[var(--brand-bg)]/30 transition-colors group">
                                    <td class="sticky left-0 z-10 bg-white group-hover:bg-[var(--brand-bg)]/20 px-6 py-4 font-bold text-[var(--brand-secondary)] border-r border-[var(--brand-bg)] text-center">@draw.WeekNumber</td>
                                    <td class="sticky left-[82px] z-10 bg-white group-hover:bg-[var(--brand-bg)]/20 px-6 py-4 border-r border-[var(--brand-bg)] text-[var(--brand-text-secondary)] italic">@draw.DrawType</td>
                                    <td class="sticky left-[152px] z-10 bg-white group-hover:bg-[var(--brand-bg)]/20 px-6 py-4 border-r border-[var(--brand-bg)] font-bold">@draw.DrawDate.ToString("dd/MM/yy")</td>
                                    <td class="px-4 py-4 text-center">
                                        <div class="flex justify-center">
                                            <div class="h-5 w-5 rounded-lg @(draw.Played ? "bg-[var(--brand-primary)]" : "bg-slate-100") flex items-center justify-center text-[10px] text-white transition-all transform @(draw.Played ? "rotate-0" : "rotate-45 opacity-50")">
                                                @(draw.Played ? "✓" : "")
                                            </div>
                                        </div>
                                    </td>
                                    
                                    <td class="px-4 py-4 text-right text-[var(--brand-text-secondary)]">@draw.CosteFija.ToString("N2")€</td>
                                    <td class="px-4 py-4 text-right text-[var(--brand-text-secondary)]">@draw.CosteAuto.ToString("N2")€</td>
                                    <td class="px-6 py-4 text-right font-bold text-[var(--brand-secondary)] bg-slate-50/10">@draw.TotalCoste.ToString("N2")€</td>
                                    
                                    <td class="px-4 py-4 text-right text-[var(--brand-primary)]">@draw.FixedPrize.ToString("N2")€</td>
                                    <td class="px-4 py-4 text-right text-[var(--brand-primary)]">@draw.AutoPrize.ToString("N2")€</td>
                                    <td class="px-6 py-4 text-right font-bold text-[var(--brand-secondary)] bg-[var(--brand-primary)]/5">@draw.TotalPremios.ToString("N2")€</td>
                                    
                                    <td class="px-6 py-4 text-right font-bold border-l border-[var(--brand-bg)] @(draw.Neto >= 0 ? "text-[var(--brand-positive)]" : "text-[var(--brand-negativo)]")">
                                        @draw.Neto.ToString("N2")€
                                    </td>
                                    <td class="px-6 py-4 text-right font-bold bg-[var(--brand-secondary)]/5 @(draw.Acumulado >= 0 ? "text-[var(--brand-positive)]" : "text-[var(--brand-negativo)]")">
                                        @draw.Acumulado.ToString("N2")€
                                    </td>
                                    
                                    <td class="px-6 py-4 max-w-[200px] truncate text-[var(--brand-text-secondary)] italic">@draw.Notes</td>
                                    
                                    <td class="px-6 py-4 flex items-center justify-end gap-3">
                                        <button @onclick="() => EditDraw(draw)" class="h-9 w-9 rounded-xl text-[var(--brand-accent)] hover:text-[var(--brand-primary)] hover:bg-[var(--brand-primary)]/10 transition-all flex items-center justify-center" title="Editar Semana">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                            </svg>
                                        </button>
                                        <button @onclick="() => ConfirmDeleteWeek(draw.WeekNumber, draw.DrawDate.Year, draw.PlanId)" class="h-9 w-9 rounded-xl text-[var(--brand-accent)] hover:text-rose-500 hover:bg-rose-50 transition-all flex items-center justify-center" title="Eliminar Semana">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                            </svg>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal Refined to match requirement list -->
@if (showModal)
{
    <div class="fixed inset-0 z-[100] flex items-center justify-center p-2 md:p-4 bg-[var(--brand-secondary)]/70 backdrop-blur-md transition-all">
        <div class="bg-white rounded-[1.5rem] md:rounded-[2.5rem] shadow-2xl w-full max-w-6xl max-h-[100dvh] md:max-h-[92vh] overflow-hidden flex flex-col animate-in fade-in zoom-in duration-300">
            <!-- Modal Header -->
            <div class="px-6 py-5 md:px-10 md:py-8 border-b border-[var(--brand-borders)] flex justify-between items-center bg-white">
                <div class="flex items-center gap-4 md:gap-6">
                    <div class="h-10 w-10 md:h-14 md:w-14 rounded-xl md:rounded-2xl @(isNewRegistration ? "bg-[var(--brand-primary)]" : "bg-[var(--brand-secondary)]") flex items-center justify-center text-white shadow-xl shadow-[var(--brand-primary)]/10">
                        @if (isNewRegistration)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 md:h-8 md:w-8" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM6.293 6.707a1 1 0 010-1.414l3-3a1 1 0 011.414 0l3 3a1 1 0 01-1.414 1.414L11 5.414V13a1 1 0 11-2 0V5.414L7.707 6.707a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                            </svg>
                        }
                        else
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 md:h-8 md:w-8" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                            </svg>
                        }
                    </div>
                    <div>
                        <h3 class="text-lg md:text-2xl font-bold text-[var(--brand-secondary)] leading-tight">@(isNewRegistration ? L["AddNewWeeklyDrawTitle"] : L["EditWeeklyDrawTitle"])</h3>
                        <p class="text-[10px] md:text-sm text-[var(--brand-text-secondary)] font-medium">@(isNewRegistration ? L["WeeklyDrawAuditSubtitle"] : L["WeeklyDrawEditSubtitle"])</p>
                    </div>
                </div>
                <button @onclick="CloseModal" class="h-10 w-10 md:h-12 md:w-12 hover:bg-[var(--brand-bg)] rounded-xl md:rounded-2xl flex items-center justify-center transition-all text-slate-300 hover:text-[var(--brand-secondary)]">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 md:h-6 md:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Modal Content -->
            <div class="flex-1 overflow-auto p-4 md:p-10 bg-[var(--brand-bg)]/30">
                <!-- Week & Plan Info -->
                <div class="flex flex-col md:flex-row gap-4 md:gap-8 mb-6 md:mb-10">
                    <div class="bg-white p-4 md:p-6 rounded-[1.5rem] md:rounded-[2rem] shadow-sm border border-[var(--brand-borders)] flex-1">
                        <label class="block text-[9px] md:text-[10px] font-bold text-[var(--brand-text-secondary)] uppercase tracking-widest mb-2 md:mb-3">@L["WeekNumberLabel"]</label>
                        <div class="flex items-center gap-4">
                            <input type="number" @bind="modalWeek" disabled="@(!isNewRegistration)" class="w-16 md:w-24 text-2xl md:text-4xl font-black @(isNewRegistration ? "text-[var(--brand-primary)]" : "text-slate-300") bg-transparent border-none p-0 focus:ring-0" />
                            @if (isNewRegistration)
                            {
                                <button @onclick="LoadWeekDataInModal" class="text-[10px] md:text-xs font-bold text-[var(--brand-primary)] hover:text-[var(--brand-secondary)] flex items-center gap-1 group">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 md:h-4 md:w-4 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                    </svg>
                                    @L["LoadDataButton"]
                                </button>
                            }
                        </div>
                    </div>
                    <div class="bg-[var(--brand-secondary)] p-5 md:p-7 rounded-[1.5rem] md:rounded-[2.5rem] shadow-xl shadow-[var(--brand-secondary)]/10 flex-[2] text-white overflow-hidden relative">
                        <div class="relative z-10">
                            <label class="block text-[9px] md:text-[10px] font-bold text-white/60 uppercase tracking-widest mb-1 md:mb-2">@L["ActivePlanDetected"]</label>
                            <div class="text-xl md:text-3xl font-black">@activePlanName</div>
                            <div class="mt-1 md:mt-2 text-[10px] md:text-xs font-medium text-white/50">
                                @(modalPlan?.BetsPerDraw ?? 0) @L["BetsPerDraw"] • Joker @(modalPlan?.EnableJoker == true ? L["Yes"] : L["No"])
                            </div>
                        </div>
                        <svg class="absolute -right-4 -bottom-4 h-24 w-24 md:h-32 md:w-32 text-white opacity-5" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6zM10 18a3 3 0 01-3-3h6a3 3 0 01-3 3z"/></svg>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(modalErrorMessage))
                {
                    <div class="mb-8 p-6 bg-rose-50 border border-rose-100 rounded-[2rem] flex gap-4 items-center animate-in slide-in-from-top-4 duration-300">
                        <div class="h-10 w-10 bg-rose-100 rounded-xl flex items-center justify-center text-rose-600 shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-rose-900 uppercase tracking-widest">Error Detectado</p>
                            <p class="text-[13px] font-medium text-rose-700/80">@modalErrorMessage</p>
                        </div>
                    </div>
                }

                @if (weekAlreadyExists && isNewRegistration)
                {
                    <div class="mb-8 p-8 bg-amber-50 border border-amber-100 rounded-[2.5rem] flex flex-col md:flex-row gap-6 items-center animate-in fade-in zoom-in duration-500">
                        <div class="h-16 w-16 bg-amber-100 rounded-[1.25rem] flex items-center justify-center text-amber-600 shrink-0 shadow-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <div class="text-center md:text-left space-y-2">
                            <h4 class="text-xl font-bold text-amber-900 tracking-tight">Semana ya registrada</h4>
                            <p class="text-sm font-medium text-amber-800/70 leading-relaxed">
                                La semana <span class="font-bold text-amber-900">@modalWeek</span> ya tiene sorteos registrados. 
                                Si deseas modificarlos, por favor pulsa el botón de edición en la lista principal.
                            </p>
                        </div>
                    </div>
                }

                @if (isModalLoading)
                {
                    <div class="flex justify-center p-24">
